<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.MainController"
            style="-fx-background-color: linear-gradient(to bottom right, #0e0f14, #1a1b22, #0f0f12);">

    <!-- TOP HEADER -->
    <top>
        <VBox spacing="6" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="18" right="12" bottom="12" left="12"/>
            </padding>

            <HBox alignment="CENTER" spacing="10">
                <Label text="Virtuarts"
                       style="-fx-text-fill: #f6d24a; -fx-font-size: 34px; -fx-font-weight: bold;"/>
            </HBox>

            <Label fx:id="statusLabel"
                   text="Drawing Studio"
                   style="-fx-text-fill: #cfcfcf; -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <!-- LEFT TOOLBAR -->
    <left>
        <VBox spacing="10"
              style="-fx-background-color: rgba(0,0,0,0.18); -fx-padding: 14;"
              prefWidth="90">

            <Button text="📏" onAction="#useLine"
                    style="-fx-background-color:#2d2d2d; -fx-text-fill:#eaeaea; -fx-background-radius: 12;"
                    prefHeight="44" prefWidth="60"/>
            <Button text="⬛" onAction="#useRect"
                    style="-fx-background-color:#2d2d2d; -fx-text-fill:#eaeaea; -fx-background-radius: 12;"
                    prefHeight="44" prefWidth="60"/>
            <Button text="⚪" onAction="#useCircle"
                    style="-fx-background-color:#2d2d2d; -fx-text-fill:#eaeaea; -fx-background-radius: 12;"
                    prefHeight="44" prefWidth="60"/>

            <Separator style="-fx-opacity:0.25;"/>

            <Button text="✏" onAction="#usePencil"
                    style="-fx-background-color:#f6d24a; -fx-text-fill:#000000; -fx-font-size: 16px; -fx-font-weight:bold; -fx-background-radius: 12;"
                    prefHeight="44" prefWidth="60"/>
            <Button text="⌫" onAction="#useEraser"
                    style="-fx-background-color:#f6d24a; -fx-text-fill:#000000; -fx-font-size: 16px; -fx-font-weight:bold; -fx-background-radius: 12;"
                    prefHeight="44" prefWidth="60"/>

            <Button text="↶" onAction="#undo"
                    style="-fx-background-color:#2d2d2d; -fx-text-fill:#eaeaea; -fx-background-radius: 12;"
                    prefHeight="44" prefWidth="60"/>
            <Button text="↷" onAction="#redo"
                    style="-fx-background-color:#2d2d2d; -fx-text-fill:#eaeaea; -fx-background-radius: 12;"
                    prefHeight="44" prefWidth="60"/>
            <Button text="⟲" onAction="#clear"
                    style="-fx-background-color:#2d2d2d; -fx-text-fill:#eaeaea; -fx-background-radius: 12;"
                    prefHeight="44" prefWidth="60"/>

            <Separator style="-fx-opacity:0.35;"/>

            <Label text="Color 🎨" style="-fx-text-fill:#cfcfcf; -fx-font-size: 11px;"/>
            <ColorPicker fx:id="colorPicker"/>

            <Label text="Size ✨" style="-fx-text-fill:#cfcfcf; -fx-font-size: 11px;"/>
            <Slider fx:id="sizeSlider" min="1" max="30" value="4" prefWidth="70"/>
        </VBox>
    </left>

    <!-- RIGHT ART PANEL -->
    <right>
        <VBox spacing="14"
              prefWidth="260"
              style="-fx-padding: 18; -fx-background-color: rgba(0,0,0,0.18);">

            <Label text="✨ Art Panel"
                   style="-fx-text-fill:#f6d24a; -fx-font-size:16px; -fx-font-weight:bold;"/>

            <Label text="Make it shine 🌟"
                   style="-fx-text-fill:#bdbdbd; -fx-font-size:12px;"/>

            <Separator style="-fx-opacity:0.25;"/>

            <Button text="🏛️ Museum" onAction="#openMuseum"
                    style="-fx-background-color:#22232a; -fx-text-fill:#ffffff; -fx-font-size: 14px; -fx-font-weight:bold; -fx-background-radius: 16;"
                    prefHeight="46"/>

            <Button text="💾 Save" onAction="#openSaveDialog"
                    style="-fx-background-color:#f6d24a; -fx-text-fill:#000000; -fx-font-size: 14px; -fx-font-weight:bold; -fx-background-radius: 16;"
                    prefHeight="46"/>

            <Separator style="-fx-opacity:0.25;"/>

            <CheckBox fx:id="glowToggle" text="🌙 Glow Mode"
                      style="-fx-text-fill:#eaeaea; -fx-font-size: 13px;"/>

            <CheckBox fx:id="sparkToggle" text="✨ Sparkles"
                      style="-fx-text-fill:#eaeaea; -fx-font-size: 13px;"/>

            <Label text="Tip: turn on Sparkles ✨"
                   style="-fx-text-fill:#8b8b8b; -fx-font-size:11px;"/>
        </VBox>
    </right>

    <!-- CENTER -->
    <center>
        <StackPane style="-fx-padding: 18;">
            <Pane fx:id="sparkLayer" mouseTransparent="true"/>

            <VBox spacing="10"
                  style="-fx-background-color: rgba(20,20,26,0.92);
                         -fx-background-radius: 26;
                         -fx-padding: 16;
                         -fx-effect: dropshadow(gaussian, rgba(246,210,74,0.18), 28, 0.2, 0, 0);">

                <Label text="🎨 Sketch Board"
                       style="-fx-text-fill:#eaeaea; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                <StackPane style="-fx-background-color:#2b2c35; -fx-background-radius: 20; -fx-padding: 12;">
                    <Canvas fx:id="canvas" width="780" height="460"/>
                    <Canvas fx:id="overlayCanvas" width="780" height="460" mouseTransparent="true"/>
                </StackPane>

            </VBox>
        </StackPane>
    </center>

    <!-- BOTTOM -->
    <bottom>
        <HBox spacing="12"
              style="-fx-background-color: rgba(0,0,0,0.18); -fx-padding: 14;"
              alignment="CENTER_LEFT">

            <Label text="Quick Access ✨"
                   style="-fx-text-fill:#cfcfcf; -fx-font-size: 13px; -fx-font-weight: bold;"/>

            <Button text="🏛️ Museum" onAction="#openMuseum"
                    style="-fx-background-color:#2d2d2d; -fx-text-fill:#eaeaea; -fx-background-radius: 12;"/>

            <Button text="🖼 Gallery" onAction="#openGallery"
                    style="-fx-background-color:#2d2d2d; -fx-text-fill:#eaeaea; -fx-background-radius: 12;"/>
        </HBox>
    </bottom>

</BorderPane>