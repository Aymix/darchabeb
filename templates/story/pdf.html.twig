<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        @page {
            margin: 60px 50px;
        }
        body {
            font-family: 'DejaVu Sans', sans-serif;
            color: #1a1a2e;
            line-height: 1.7;
            font-size: 11pt;
        }

        /* ── Cover Page ── */
        .cover {
            text-align: center;
            padding-top: 200px;
            page-break-after: always;
        }
        .cover h1 {
            font-size: 32pt;
            color: #7c3aed;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
        }
        .cover .genre {
            font-size: 12pt;
            color: #6b7280;
            margin-bottom: 20px;
        }
        .cover .status {
            display: inline-block;
            background: #7c3aed;
            color: #fff;
            padding: 4px 18px;
            border-radius: 12px;
            font-size: 10pt;
            font-weight: bold;
            letter-spacing: 1px;
        }
        .cover .synopsis-label {
            font-size: 11pt;
            color: #9ca3af;
            margin-top: 80px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .cover .synopsis {
            font-size: 11pt;
            color: #374151;
            max-width: 400px;
            margin: 12px auto 0;
            line-height: 1.8;
        }
        .cover .divider {
            width: 80px;
            height: 3px;
            background: #7c3aed;
            margin: 30px auto;
            border-radius: 2px;
        }

        /* ── Chapter ── */
        .chapter {
            page-break-before: always;
        }
        .chapter-title {
            font-size: 20pt;
            color: #7c3aed;
            margin-bottom: 6px;
            padding-bottom: 8px;
            border-bottom: 2px solid #e5e7eb;
        }
        .chapter-number {
            font-size: 10pt;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-bottom: 4px;
        }

        /* ── Scene ── */
        .scene {
            margin: 28px 0;
            padding: 16px 20px;
            background: #f9fafb;
            border-left: 4px solid #7c3aed;
            border-radius: 0 8px 8px 0;
        }
        .scene-title {
            font-size: 13pt;
            font-weight: bold;
            color: #1f2937;
            margin-bottom: 4px;
        }
        .scene-status {
            font-size: 8pt;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }
        .scene p {
            margin: 6px 0 0;
            color: #374151;
        }

        /* ── Footer ── */
        .footer {
            position: fixed;
            bottom: 20px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 8pt;
            color: #9ca3af;
        }
    </style>
</head>
<body>

    <!-- Cover Page -->
    <div class="cover">
        <h1>{{ story.title }}</h1>
        <div class="genre">{{ story.genreNames }}</div>
        <div class="status">{{ story.status ?? 'DRAFT' }}</div>
        {% if story.content %}
            <div class="divider"></div>
            <div class="synopsis-label">Synopsis</div>
            <div class="synopsis">{{ story.content }}</div>
        {% endif %}
    </div>

    <!-- Chapters -->
    {% for chapter in story.chapters %}
    <div class="chapter">
        <div class="chapter-number">Chapter {{ chapter.orderIndex ?? loop.index }}</div>
        <div class="chapter-title">{{ chapter.title }}</div>

        {% if chapter.scenes is defined %}
        {% for scene in chapter.scenes %}
        <div class="scene">
            <div class="scene-title">{{ scene.title }}</div>
            <div class="scene-status">{{ scene.status }}</div>
            <p>{{ scene.content|nl2br }}</p>
        </div>
        {% endfor %}
        {% endif %}
    </div>
    {% endfor %}

    {% if story.chapters|length == 0 %}
    <div style="text-align:center;padding-top:60px;color:#9ca3af;">
        <p style="font-size:14pt;">This story has no chapters yet.</p>
    </div>
    {% endif %}

    <div class="footer">
        Generated by VirtuArts — Story Workshop
    </div>
</body>
</html>
