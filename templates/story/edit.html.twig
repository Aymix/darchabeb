{% extends 'base.html.twig' %}
{% block title %}Edit Story — VirtuArts{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/aura-embed.css') }}">
{% endblock %}

{% block body %}
<section class="module-page">
    <div class="module-topbar">
        <a href="{{ path('app_story_show', {id: story.id}) }}" class="btn btn-ghost"><i data-lucide="arrow-left" class="btn-icon"></i> Back</a>
        <h1 class="module-title"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ff9500" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" opacity=".3"/></svg> Edit Story</h1>
    </div>

    <div class="form-card">
        <form method="post" action="{{ path('app_story_edit', {id: story.id}) }}">
            <div class="form-group">
                <label for="title">Story Title</label>
                <input type="text" id="title" name="title" class="form-control" value="{{ story.title }}" required>
            </div>

            {# ── Multi-Genre Selector ── #}
            <div class="form-group">
                <label>Genres <span style="color:var(--text-muted);font-weight:400;">(select 1 or more)</span></label>
                {% set storyGenreIds = [] %}
                {% for g in story.genres %}
                    {% set storyGenreIds = storyGenreIds|merge([g.id]) %}
                {% endfor %}

                <div class="genre-selector" id="genreSelector">
                    {% for genre in genres %}
                    <label class="genre-chip">
                        <input type="checkbox" name="genres[]" value="{{ genre.id }}"
                               {{ genre.id in storyGenreIds ? 'checked' : '' }}>
                        <span class="genre-chip-label">{{ genre.name }}</span>
                    </label>
                    {% endfor %}
                </div>

                {# Add custom genre #}
                <div class="add-genre-row" style="margin-top:var(--space-sm);">
                    <input type="text" id="newGenreName" class="form-control" placeholder="Add a new genre..."
                           style="flex:1;max-width:250px;">
                    <button type="button" class="btn btn-outline btn-sm" onclick="addCustomGenre()">
                        <i data-lucide="plus" style="width:14px;height:14px;"></i> Add Genre
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label for="content">Synopsis / Content</label>
                <div class="stt-textarea-wrap">
                    <textarea id="content" name="content" class="form-control" rows="10">{{ story.content }}</textarea>
                    <button type="button" class="stt-mic-btn" onclick="toggleDictation('content', this)" title="Dictate with voice">
                        <i data-lucide="mic" style="width:16px;height:16px;"></i>
                    </button>
                </div>
                <span class="stt-status" id="stt-status-content"></span>
            </div>
            <div style="display:flex;gap:var(--space-md);">
                <button type="submit" class="btn btn-primary btn-lg"><i data-lucide="save" class="btn-icon"></i> Save Changes</button>
                <form method="post" action="{{ path('app_story_delete', {id: story.id}) }}" onsubmit="return confirm('Delete this story?');">
                    <button type="submit" class="btn btn-danger btn-lg"><i data-lucide="trash-2" class="btn-icon"></i> Delete</button>
                </form>
            </div>
        </form>
    </div>

    {# ━━━ AI WRITING ASSISTANT ━━━ #}
    <div style="max-width:700px;margin:24px auto 0;padding:0 var(--space-lg);">
        {% include 'components/_aura_panel.html.twig' with { module: 'story' } %}
    </div>
</section>
{% endblock %}

{% block page_scripts %}
<style>
.genre-selector {
    display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px;
}
.genre-chip { cursor: pointer; user-select: none; }
.genre-chip input { display: none; }
.genre-chip-label {
    display: inline-block; padding: 6px 16px;
    border-radius: 999px; font-size: 0.82rem; font-weight: 600;
    background: var(--bg-secondary); color: var(--text-muted);
    border: 2px solid var(--border); transition: all .2s;
}
.genre-chip input:checked + .genre-chip-label {
    background: var(--accent); color: #fff;
    border-color: var(--accent);
    box-shadow: 0 2px 8px rgba(124,58,237,.3);
}
.genre-chip-label:hover { border-color: var(--accent); color: var(--accent); }
.add-genre-row { display: flex; gap: 8px; align-items: center; }

/* ── Speech-to-Text dictation ── */
.stt-textarea-wrap {
    position: relative;
}
.stt-mic-btn {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(139,92,246,0.1);
    border: 1px solid rgba(139,92,246,0.25);
    color: rgba(139,92,246,0.6);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 5;
}
.stt-mic-btn:hover {
    background: rgba(139,92,246,0.2);
    color: #a78bfa;
}
.stt-mic-btn.recording {
    background: rgba(239,68,68,0.2);
    border-color: rgba(239,68,68,0.4);
    color: #ef4444;
    animation: sttPulse 1s ease-in-out infinite;
}
@keyframes sttPulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.3); }
    50% { box-shadow: 0 0 0 8px rgba(239,68,68,0); }
}
.stt-status {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(139,92,246,0.6);
    min-height: 18px;
    margin-top: 4px;
}
</style>
<script>
if (typeof lucide !== 'undefined') { lucide.createIcons(); }

async function addCustomGenre() {
    const input = document.getElementById('newGenreName');
    const name = input.value.trim();
    if (!name) return;

    try {
        const res = await fetch('{{ path("app_genre_add") }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'name=' + encodeURIComponent(name)
        });
        const data = await res.json();
        if (data.error) { alert(data.error); return; }

        const selector = document.getElementById('genreSelector');
        const label = document.createElement('label');
        label.className = 'genre-chip';
        label.innerHTML = `<input type="checkbox" name="genres[]" value="${data.id}" checked><span class="genre-chip-label">${data.name}</span>`;
        selector.appendChild(label);
        input.value = '';
    } catch (err) {
        alert('Failed to add genre. Please try again.');
    }
}
</script>

<script>
/* ═══════════════════════════════════════
   SPEECH-TO-TEXT (DICTATION)
═══════════════════════════════════════ */
const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
let activeRecognition = null;
let activeRecField = null;

function toggleDictation(textareaId, btn) {
    if (!SpeechRecognition) {
        alert('Your browser does not support Speech Recognition. Please use Chrome or Edge.');
        return;
    }

    // If already recording this field, stop
    if (activeRecField === textareaId && activeRecognition) {
        activeRecognition.stop();
        return;
    }

    // Stop any existing
    if (activeRecognition) activeRecognition.stop();

    const textarea = document.getElementById(textareaId);
    const statusEl = document.getElementById('stt-status-' + textareaId);
    if (!textarea) return;

    const recognition = new SpeechRecognition();
    recognition.lang = 'en-US';
    recognition.interimResults = true;
    recognition.continuous = true;
    recognition.maxAlternatives = 1;

    let finalTranscript = '';

    recognition.onstart = () => {
        btn.classList.add('recording');
        if (statusEl) statusEl.textContent = '🎙️ Listening… speak now';
        activeRecField = textareaId;
        activeRecognition = recognition;
    };

    recognition.onresult = (event) => {
        let interim = '';
        for (let i = event.resultIndex; i < event.results.length; i++) {
            const transcript = event.results[i][0].transcript;
            if (event.results[i].isFinal) {
                finalTranscript += transcript + ' ';
            } else {
                interim += transcript;
            }
        }
        // Append final text to textarea
        if (finalTranscript) {
            const curVal = textarea.value;
            const needsSpace = curVal.length > 0 && !curVal.endsWith(' ') && !curVal.endsWith('\n');
            textarea.value = curVal + (needsSpace ? ' ' : '') + finalTranscript;
            finalTranscript = '';
        }
        if (statusEl) statusEl.textContent = interim ? '🎙️ "' + interim + '"' : '🎙️ Listening…';
    };

    recognition.onerror = (event) => {
        console.warn('STT error:', event.error);
        if (statusEl) statusEl.textContent = '⚠️ ' + event.error;
        btn.classList.remove('recording');
        activeRecField = null;
        activeRecognition = null;
    };

    recognition.onend = () => {
        btn.classList.remove('recording');
        if (statusEl) statusEl.textContent = '';
        activeRecField = null;
        activeRecognition = null;
    };

    recognition.start();
}
</script>
<script src="{{ asset('js/aura-embed.js') }}" defer></script>
{% endblock %}
