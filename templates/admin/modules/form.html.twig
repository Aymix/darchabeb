{% extends 'base.html.twig' %}
{% block title %}{{ formTitle }} — VirtuArts Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/dashboard-3d.css') }}">
{% endblock %}

{% block body %}
<div class="db3-page">
    <div class="db3-bg"></div>
    <div class="db3-container">

        {# ── HEADER ── #}
        <div class="db3-header">
            <div class="db3-header-left">
                <h1>{{ formTitle }}</h1>
                <p>{{ module ? 'Edit module configuration' : 'Register a new activity module' }}</p>
            </div>
            <a href="{{ path('app_admin_modules') }}" class="db3-btn db3-btn-ghost">
                <i data-lucide="arrow-left"></i> Back to Modules
            </a>
        </div>

        <div class="db3-form-card" style="max-width:600px;">
            <form method="post">
                <div class="db3-form-group" style="margin-bottom:20px;">
                    <label><i data-lucide="type"></i> Module Name</label>
                    <input type="text" name="name" value="{{ module ? module.name : '' }}"
                           placeholder="e.g. Drawing Studio" required>
                </div>

                <div class="db3-form-row">
                    <div class="db3-form-group">
                        <label><i data-lucide="smile"></i> Emoji / Icon</label>
                        <input type="text" name="emoji" value="{{ module ? module.emoji : '' }}" placeholder="🎨">
                    </div>
                    <div class="db3-form-group">
                        <label><i data-lucide="toggle-right"></i> Status</label>
                        <select name="status">
                            <option value="ACTIVE" {{ module and module.status == 'ACTIVE' ? 'selected' : '' }}>ACTIVE</option>
                            <option value="BLOCKED" {{ module and module.status == 'BLOCKED' ? 'selected' : '' }}>BLOCKED</option>
                        </select>
                    </div>
                </div>

                <div class="db3-form-group" style="margin-bottom:20px;">
                    <label><i data-lucide="user"></i> Supervisor Name</label>
                    <input type="text" name="supervisor_name" value="{{ module ? module.supervisorName : '' }}"
                           placeholder="Supervisor VirtuArts">
                </div>

                <div style="display:flex;gap:12px;margin-top:8px;">
                    <button type="submit" class="db3-btn db3-btn-primary" style="flex:1;justify-content:center;">
                        <i data-lucide="{{ module ? 'save' : 'check' }}"></i>
                        {{ module ? 'Save Changes' : 'Create Module' }}
                    </button>
                    <a href="{{ path('app_admin_modules') }}" class="db3-btn db3-btn-ghost" style="flex:1;justify-content:center;text-decoration:none;">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="{{ asset('js/dashboard-3d.js') }}"></script>
<script>
    if (typeof lucide !== 'undefined') lucide.createIcons();
</script>
{% endblock %}
