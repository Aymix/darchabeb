{% extends 'base.html.twig' %}
{% block title %}Manage Users — VirtuArts Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/dashboard-3d.css') }}">
{% endblock %}

{% block body %}
<div class="db3-page">
    <div class="db3-bg"></div>
    <div class="db3-container">

        {# ── FLASH MESSAGES ── #}
        {% for type, messages in app.flashes %}
        <div class="db3-flash-wrap">
            {% for msg in messages %}
            <div class="db3-flash {{ type }}">
                <i data-lucide="{{ type == 'success' ? 'check-circle' : (type == 'error' ? 'x-circle' : 'alert-triangle') }}"></i>
                {{ msg }}
            </div>
            {% endfor %}
        </div>
        {% endfor %}

        {# ── HEADER ── #}
        <div class="db3-header">
            <div class="db3-header-left">
                <h1>Manage Users</h1>
                <p>View, edit, and manage all platform user accounts</p>
            </div>
            <div style="display:flex;gap:10px;align-items:center;">
                <a href="{{ path('app_admin_dashboard') }}" class="db3-btn db3-btn-ghost">
                    <i data-lucide="arrow-left"></i> Dashboard
                </a>
                <a href="{{ path('app_admin_user_create') }}" class="db3-btn db3-btn-primary">
                    <i data-lucide="user-plus"></i> Add User
                </a>
            </div>
        </div>

        {# ── SEARCH ── #}
        <form method="get" action="{{ path('app_admin_users') }}" style="margin-bottom:28px;">
            <div class="db3-search" style="display:flex;gap:10px;align-items:center;">
                <i data-lucide="search"></i>
                <input type="text" name="q" value="{{ search }}" placeholder="Search by name or email…">
                <button type="submit" class="db3-btn db3-btn-primary db3-btn-sm" style="margin-left:-4px;">Search</button>
            </div>
        </form>

        {# ── USERS TABLE ── #}
        {% if users is empty %}
            <div class="db3-empty"><i data-lucide="users"></i><p>No users found.</p></div>
        {% else %}
        <div class="db3-table-wrap">
            <table class="db3-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Age</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for user in users %}
                <tr class="{{ user.blocked ? 'row-blocked' : '' }}">
                    <td class="td-dim">#{{ user.id }}</td>
                    <td class="td-bold">{{ user.fullName }}</td>
                    <td class="td-mono">{{ user.email }}</td>
                    <td>{{ user.age }}</td>
                    <td>
                        <span class="db3-role {{ user.role|lower|default('user') }}">
                            {{ user.role|default('USER') }}
                        </span>
                    </td>
                    <td>
                        {% if user.blocked %}
                            <span class="db3-status blocked">Blocked</span>
                        {% else %}
                            <span class="db3-status active">Active</span>
                        {% endif %}
                    </td>
                    <td>
                        <div style="display:flex;gap:6px;align-items:center;">
                            <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="db3-btn db3-btn-primary db3-btn-sm">
                                <i data-lucide="pencil"></i> Edit
                            </a>
                            <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}"
                                  onsubmit="return confirm('Delete this user permanently?');" style="margin:0;">
                                <button type="submit" class="db3-btn db3-btn-danger db3-btn-sm">
                                    <i data-lucide="trash-2"></i> Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}

    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="{{ asset('js/dashboard-3d.js') }}"></script>
<script>
    if (typeof lucide !== 'undefined') lucide.createIcons();
</script>
{% endblock %}
