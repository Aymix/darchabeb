{% extends 'base.html.twig' %}
{% block title %}{{ formTitle }} — VirtuArts Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/dashboard-3d.css') }}">
{% endblock %}

{% block body %}
<div class="db3-page">
    <div class="db3-bg"></div>
    <div class="db3-container">

        {# ── HEADER ── #}
        <div class="db3-header">
            <div class="db3-header-left">
                <h1>{{ formTitle }}</h1>
                <p>{{ user ? 'Editing account details' : 'Create a new platform account' }}</p>
            </div>
            <a href="{{ path('app_admin_users') }}" class="db3-btn db3-btn-ghost">
                <i data-lucide="arrow-left"></i> Back to Users
            </a>
        </div>

        <div class="db3-form-card" style="max-width:680px;">
            <form method="post">
                <div class="db3-form-row">
                    <div class="db3-form-group">
                        <label><i data-lucide="user"></i> First Name</label>
                        <input type="text" name="first_name" value="{{ user ? user.firstName : '' }}"
                               placeholder="John" required minlength="2">
                    </div>
                    <div class="db3-form-group">
                        <label><i data-lucide="user"></i> Last Name</label>
                        <input type="text" name="last_name" value="{{ user ? user.lastName : '' }}"
                               placeholder="Doe" required minlength="2">
                    </div>
                </div>

                <div class="db3-form-group" style="margin-bottom:20px;">
                    <label><i data-lucide="mail"></i> Email Address</label>
                    <input type="email" name="email" value="{{ user ? user.email : '' }}"
                           placeholder="john.doe@example.com" required>
                </div>

                <div class="db3-form-row">
                    <div class="db3-form-group">
                        <label><i data-lucide="calendar"></i> Age</label>
                        <input type="number" name="age" value="{{ user ? user.age : '' }}" min="5" max="100">
                    </div>
                    <div class="db3-form-group">
                        <label><i data-lucide="shield"></i> Account Role</label>
                        <select name="role">
                            <option value="USER" {{ user and user.role == 'USER' ? 'selected' : '' }}>User (Artist)</option>
                            <option value="SUPERVISEUR" {{ user and user.role == 'SUPERVISEUR' ? 'selected' : '' }}>Supervisor</option>
                            <option value="ADMIN" {{ user and user.role == 'ADMIN' ? 'selected' : '' }}>Admin</option>
                        </select>
                    </div>
                </div>

                <div class="db3-form-group" style="margin-bottom:20px;">
                    <label><i data-lucide="lock"></i> Password {{ user ? '(leave blank to keep current)' : '' }}</label>
                    <input type="password" name="password" placeholder="••••••••" {{ user ? '' : 'required' }}>
                </div>

                <div style="display:flex;gap:12px;margin-top:8px;">
                    <button type="submit" class="db3-btn db3-btn-primary" style="flex:1;justify-content:center;">
                        <i data-lucide="{{ user ? 'save' : 'check' }}"></i>
                        {{ user ? 'Save Changes' : 'Create Account' }}
                    </button>
                    <a href="{{ path('app_admin_users') }}" class="db3-btn db3-btn-ghost" style="flex:1;justify-content:center;text-decoration:none;">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="{{ asset('js/dashboard-3d.js') }}"></script>
<script>
    if (typeof lucide !== 'undefined') lucide.createIcons();
</script>
{% endblock %}
