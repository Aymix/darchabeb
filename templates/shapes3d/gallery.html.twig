{% extends 'base.html.twig' %}
{% block title %}3D Gallery — VirtuArts{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/shape-builder.css') }}">
{% endblock %}

{% block body %}
<section class="module-page">
    <div class="module-topbar">
        <a href="{{ path('app_shapes3d_builder') }}" class="btn btn-ghost">← Builder</a>
        <h1 class="module-title"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ff9500" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="M3.3 7 12 12l8.7-5" opacity=".4"/><path d="M12 22V12" opacity=".4"/></svg> 3D Creation Gallery</h1>
        <div class="module-actions">
            <a href="{{ path('app_shapes3d_builder') }}" class="btn btn-primary">+ New Creation</a>
        </div>
    </div>

    {% if shapes is empty %}
        <div class="empty-state">
            <p>No 3D creations yet. Open the builder and start creating!</p>
            <a href="{{ path('app_shapes3d_builder') }}" class="btn btn-primary">Open Studio</a>
        </div>
    {% else %}
    <div class="gallery-grid">
        {% for shape in shapes %}
        <div class="gallery-card">
            <div class="gallery-img">
                {% if shape.imagePath %}
                    <img src="{{ shape.imagePath }}" alt="{{ shape.title ?? 'Shape' }}" style="width:100%;height:100%;object-fit:cover;">
                {% else %}
                    <div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-size:3rem;color:{{ shape.color ?? '#f97316' }};">
                        {% if shape.shapeType == 'cube' %}🧊
                        {% elseif shape.shapeType == 'sphere' %}🔮
                        {% elseif shape.shapeType == 'pyramid' %}🔺
                        {% elseif shape.shapeType == 'cylinder' %}🛢️
                        {% else %}🔷{% endif %}
                    </div>
                {% endif %}
            </div>
            <div class="gallery-info">
                <h3>{{ shape.title ?? shape.shapeType|default('Shape')|capitalize }}</h3>
                <span class="gallery-date" style="display:flex;align-items:center;gap:var(--space-xs);flex-wrap:wrap;">
                    {% if shape.user %}
                        <span style="font-size:0.75rem;color:var(--color-text-muted);">by {{ shape.user.fullName }}</span>
                        <span style="color:#3a3a3a;">·</span>
                    {% endif %}
                    {% if shape.createdAt %}
                        {{ shape.createdAt|date('d/m/Y') }}
                    {% endif %}
                    <span style="color:#3a3a3a;">·</span>
                    ❤️ {{ shape.likes }}
                </span>
                {% if shape.sceneData %}
                <div style="margin-top:var(--space-sm);">
                    <a href="{{ path('app_shapes3d_edit', {id: shape.id}) }}" class="btn btn-outline btn-sm" style="font-size:0.75rem;">
                        ✏️ Edit Scene
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</section>
{% endblock %}
