{% extends 'base.html.twig' %}
{% block title %}Our Services — VirtuArts{% endblock %}
{% block body %}
<div class="page-section">
    <div class="container">
        <h1>Our Services</h1>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon">🎨</div>
                <h3>Drawing &amp; Painting</h3>
                <p>Multi-layer digital drawing with a full-featured canvas. Tag, publish, and get likes from the community.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🕹️</div>
                <h3>Pixel Art &amp; 3D Shapes</h3>
                <p>Create pixel art masterpieces and design 3D shapes with custom colors, textures, and sizes.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📚</div>
                <h3>Collaborative Writing</h3>
                <p>Build stories together with chapters, scenes, and versioned contributions from multiple authors.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🎸</div>
                <h3>Music &amp; Audio</h3>
                <p>Explore acoustic music workshops and digital production sessions guided by experienced supervisors.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🏛️</div>
                <h3>Virtual Museum</h3>
                <p>Submit your best artwork for curation in our virtual museum — the ultimate showcase of creativity.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📢</div>
                <h3>Artist Social Feed</h3>
                <p>Share creative posts, earn Magic Sparks, comment, and build your artist reputation.</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
