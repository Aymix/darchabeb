{% extends 'base.html.twig' %}
{% block title %}Contact Us — VirtuArts{% endblock %}
{% block body %}
<div class="page-section">
    <div class="container">
        <h1>Contact Us</h1>
        <div class="content-card">
            <p>Have questions, feedback, or want to collaborate? Reach out to the VirtuArts team!</p>
            <div class="contact-grid">
                <div class="contact-item">
                    <span class="contact-icon">📧</span>
                    <h3>Email</h3>
                    <p>contact@virtuarts.tn</p>
                </div>
                <div class="contact-item">
                    <span class="contact-icon">📍</span>
                    <h3>Location</h3>
                    <p>Esprit School of Engineering, Tunis, Tunisia</p>
                </div>
                <div class="contact-item">
                    <span class="contact-icon">🕐</span>
                    <h3>Hours</h3>
                    <p>Monday – Friday, 9:00 AM – 5:00 PM</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
