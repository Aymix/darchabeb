{% extends 'base.html.twig' %}
{% block title %}About Us — VirtuArts{% endblock %}
{% block body %}
<div class="page-section">
    <div class="container">
        <h1>About VirtuArts</h1>
        <div class="content-card">
            <p>VirtuArts is a <strong>Virtual Youth Arts House</strong> — a digital creative platform designed to empower young artists aged 5 to 25+ with tools for drawing, writing, music production, and collaborative storytelling.</p>
            <p>Our mission is to provide a safe, inspiring, and gamified environment where creativity thrives. Whether you're sketching your first drawing, composing a melody, or co-authoring a story with friends, VirtuArts gives you the canvas to express yourself.</p>
            <h2>Our Values</h2>
            <ul>
                <li><strong>Creativity First</strong> — Every tool and feature is designed to spark imagination.</li>
                <li><strong>Collaboration</strong> — Art is better when created together.</li>
                <li><strong>Inclusivity</strong> — Everyone can be an artist, regardless of experience.</li>
                <li><strong>Gamification</strong> — Learning and creating should be fun and rewarding.</li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}
