{% extends 'base.html.twig' %}
{% block title %}Pixel Art Editor — VirtuArts{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/aura-embed.css') }}">
{% endblock %}

{% block body %}
<section class="module-page">
    <div class="module-topbar">
        <a href="{{ path('app_user_dashboard') }}" class="btn btn-ghost">← Dashboard</a>
        <h1 class="module-title"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ff9500" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg> Pixel Art Editor</h1>
        <div class="module-actions">
            <a href="{{ path('app_pixelart_gallery') }}" class="btn btn-outline">Gallery</a>
        </div>
    </div>

    <div class="studio-layout">
        {# ── TOOLBAR ── #}
        <div class="studio-toolbar">
            <div class="toolbar-section">
                <h3>Tools</h3>
                <div class="tool-grid">
                    <button data-px-tool="pen" class="tool-btn active" title="Pen"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16.5 3.5 4 4L7 21H3v-4L16.5 3.5Z"/></svg></button>
                    <button data-px-tool="eraser" class="tool-btn" title="Eraser"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 13-7 7H6l-3-3a2 2 0 0 1 0-3l10-10a2 2 0 0 1 3 0l2 2a2 2 0 0 1 0 3Z"/><path d="M20 21H6" opacity=".4"/></svg></button>
                    <button data-px-tool="fill" class="tool-btn" title="Fill"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m2.5 13.5 9-9 7 7-9 9a1 1 0 0 1-1.4 0l-5.6-5.6a1 1 0 0 1 0-1.4Z"/><path d="M20 16c1 1.5 0 3-1.5 3S17 17.5 18 16l2-3Z" fill="currentColor" opacity=".4"/></svg></button>
                </div>
            </div>

            <div class="toolbar-section">
                <h3>Grid Size</h3>
                <div class="tool-grid">
                    <button data-grid-size="16" class="tool-btn active">16×16</button>
                    <button data-grid-size="32" class="tool-btn">32×32</button>
                    <button data-grid-size="64" class="tool-btn">64×64</button>
                </div>
            </div>

            <div class="toolbar-section">
                <h3>Color</h3>
                <input type="color" id="pxColorPicker" value="#f97316" class="color-input">
                <div class="color-palette">
                    <span data-px-color="#f97316" class="swatch" style="background:#f97316"></span>
                    <span data-px-color="#ef4444" class="swatch" style="background:#ef4444"></span>
                    <span data-px-color="#eab308" class="swatch" style="background:#eab308"></span>
                    <span data-px-color="#22c55e" class="swatch" style="background:#22c55e"></span>
                    <span data-px-color="#3b82f6" class="swatch" style="background:#3b82f6"></span>
                    <span data-px-color="#8b5cf6" class="swatch" style="background:#8b5cf6"></span>
                    <span data-px-color="#ec4899" class="swatch" style="background:#ec4899"></span>
                    <span data-px-color="#000000" class="swatch" style="background:#000000"></span>
                    <span data-px-color="#ffffff" class="swatch" style="background:#ffffff;border:1px solid #444"></span>
                    <span data-px-color="#f59e0b" class="swatch" style="background:#f59e0b"></span>
                    <span data-px-color="#06b6d4" class="swatch" style="background:#06b6d4"></span>
                    <span data-px-color="#a855f7" class="swatch" style="background:#a855f7"></span>
                </div>
            </div>

            {# ━━━ COLOR API — PALETTE GENERATOR ━━━ #}
            <div class="toolbar-section">
                <h3><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px"><circle cx="12" cy="12" r="10"/><path d="M12 2a7 7 0 0 0 0 20 2 2 0 0 0 2-2v-1a2 2 0 0 1 2-2h1a2 2 0 0 0 2-2 7 7 0 0 0-7-13Z"/><circle cx="8" cy="10" r="1.5" fill="currentColor" opacity=".5"/><circle cx="12" cy="7" r="1.5" fill="currentColor" opacity=".5"/><circle cx="16" cy="10" r="1.5" fill="currentColor" opacity=".5"/></svg> Smart Palette</h3>
                <div style="display:flex;gap:6px;align-items:center;margin-bottom:8px;">
                    <select id="colorMode" style="flex:1;padding:5px 8px;font-size:.78rem;background:var(--color-bg-raised);border:1px solid var(--border);border-radius:6px;color:#fff;">
                        <option value="analogic">Analogic</option>
                        <option value="complement">Complement</option>
                        <option value="triad">Triad</option>
                        <option value="quad">Quad</option>
                        <option value="monochrome">Mono</option>
                        <option value="analogic-complement">Analogic Comp.</option>
                    </select>
                    <button id="genPalette" class="btn btn-outline btn-sm" style="white-space:nowrap;">Generate</button>
                </div>
                <div id="colorApiResults" style="display:flex;gap:4px;flex-wrap:wrap;"></div>
                <div id="colorApiInfo" style="font-size:.6rem;color:var(--color-text-muted);margin-top:4px;"></div>
            </div>

            <div class="toolbar-section">
                <h3>Actions</h3>
                <button id="pxClear" class="btn btn-outline btn-block"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M5 6v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6"/></svg> Clear</button>
                <button id="pxDownload" class="btn btn-outline btn-block" style="margin-top:var(--space-sm)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px"><path d="M12 3v13"/><path d="m8 12 4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg> Download</button>
            </div>

            <button id="pxSave" class="btn btn-primary btn-block"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg> Save to Gallery</button>

            {# ━━━ AI ASSISTANT ━━━ #}
            <div style="margin-top:16px;">
                {% include 'components/_aura_panel.html.twig' with { module: 'pixel_art' } %}
            </div>
        </div>

        {# ── PIXEL CANVAS ── #}
        <div class="studio-canvas-wrap" style="display:flex;align-items:center;justify-content:center;background:var(--color-bg-raised);">
            <canvas id="pixelCanvas" style="image-rendering:pixelated;cursor:crosshair;max-width:100%;"></canvas>
        </div>
    </div>
</section>
{% endblock %}

{% block page_scripts %}
<script src="{{ asset('js/pixel-editor.js') }}"></script>
<script src="{{ asset('js/aura-embed.js') }}" defer></script>
<script>
// ── The Color API — Smart Palette Generator ──
(function(){
    const genBtn = document.getElementById('genPalette');
    const modeSelect = document.getElementById('colorMode');
    const results = document.getElementById('colorApiResults');
    const info = document.getElementById('colorApiInfo');
    const picker = document.getElementById('pxColorPicker');

    genBtn.addEventListener('click', async () => {
        const hex = picker.value.replace('#','');
        const mode = modeSelect.value;
        results.innerHTML = '<span style="font-size:.75rem;color:var(--color-text-muted);">Loading…</span>';
        try {
            const res = await fetch(`{{ path('api_colorapi_scheme') }}?hex=${hex}&mode=${mode}&count=6`);
            const data = await res.json();
            if (data.error) { results.innerHTML = `<span style="color:#f87171;font-size:.75rem;">${data.error}</span>`; return; }
            results.innerHTML = data.colors.map(c => `
                <span class="swatch" data-px-color="${c.hex}" style="background:${c.hex};width:28px;height:28px;border-radius:6px;cursor:pointer;border:2px solid transparent;transition:all .15s;" 
                      title="${c.name} (${c.hex})"
                      onmouseover="this.style.borderColor='#fff';this.style.transform='scale(1.15)'" 
                      onmouseout="this.style.borderColor='transparent';this.style.transform='scale(1)'"></span>
            `).join('');
            info.textContent = `${data.mode} palette from ${data.seed.name}`;
            // Make generated swatches clickable
            results.querySelectorAll('[data-px-color]').forEach(s => {
                s.addEventListener('click', () => {
                    picker.value = s.dataset.pxColor;
                    picker.dispatchEvent(new Event('input'));
                });
            });
        } catch(e) { results.innerHTML = '<span style="color:#f87171;font-size:.75rem;">Failed to generate palette.</span>'; }
    });
})();
</script>
{% endblock %}
