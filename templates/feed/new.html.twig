{% extends 'base.html.twig' %}
{% block title %}New Post — VirtuArts{% endblock %}

{% block body %}
<section class="module-page">
    <div class="module-topbar">
        <a href="{{ path('app_feed_index') }}" class="btn btn-ghost">← Feed</a>
        <h1 class="module-title"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ff9500" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg> New Post</h1>
    </div>

    <div class="form-card">
        <form method="post" action="{{ path('app_feed_new') }}" enctype="multipart/form-data">
            <div class="form-group">
                <label for="description">What's on your mind?</label>
                <textarea id="description" name="description" class="form-control" rows="5" placeholder="Share your creative journey, ask for feedback, or celebrate a milestone..." required></textarea>
            </div>
            <div class="form-group">
                <label for="image">Attach an image (optional)</label>
                <input type="file" id="image" name="image" class="form-control" accept="image/*">
            </div>

            {# ━━━ GIPHY GIF PICKER ━━━ #}
            <div class="form-group">
                <label>Add a GIF (Giphy)</label>
                <div style="display:flex;gap:6px;margin-bottom:8px;">
                    <input type="text" id="giphyQuery" class="form-control" placeholder="Search GIFs… (e.g. happy, celebrate, art)">
                    <button type="button" id="giphySearch" class="btn btn-outline" style="white-space:nowrap;">🔍 Search</button>
                </div>
                <div id="giphyResults" style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;max-height:220px;overflow-y:auto;border-radius:8px;"></div>
                <div id="giphySelected" style="margin-top:8px;display:none;">
                    <div style="display:flex;align-items:center;gap:8px;">
                        <img id="giphyPreview" src="" alt="Selected GIF" style="height:60px;border-radius:6px;">
                        <button type="button" id="giphyClear" class="btn btn-ghost btn-sm">✕ Remove</button>
                    </div>
                </div>
                <input type="hidden" id="giphyUrl" name="gif_url" value="">
                <div id="giphyInfo" style="font-size:.6rem;color:var(--color-text-muted,#888);margin-top:4px;"></div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">Publish Post</button>
        </form>
    </div>
</section>
{% endblock %}

{% block page_scripts %}
<script>
// ── Giphy GIF Picker API ──
(function(){
    const input = document.getElementById('giphyQuery');
    const btn = document.getElementById('giphySearch');
    const grid = document.getElementById('giphyResults');
    const info = document.getElementById('giphyInfo');
    const selectedWrap = document.getElementById('giphySelected');
    const preview = document.getElementById('giphyPreview');
    const hiddenInput = document.getElementById('giphyUrl');
    const clearBtn = document.getElementById('giphyClear');

    async function searchGiphy() {
        const q = input.value.trim();
        if (!q) return;
        grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:16px;color:var(--color-text-muted,#888);font-size:.82rem;">Searching…</div>';
        info.textContent = '';
        try {
            const res = await fetch(`{{ path('api_giphy_search') }}?q=${encodeURIComponent(q)}&limit=12`);
            const data = await res.json();
            if (data.error) { grid.innerHTML = `<div style="grid-column:1/-1;color:#f87171;font-size:.78rem;padding:12px;">${data.error}</div>`; return; }
            if (!data.results.length) { grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:16px;color:var(--color-text-muted,#888);">No GIFs found.</div>'; return; }
            grid.innerHTML = data.results.map(g => `
                <div class="giphy-thumb" data-url="${g.url}" style="cursor:pointer;border-radius:6px;overflow:hidden;border:2px solid transparent;transition:all .15s;aspect-ratio:1;">
                    <img src="${g.thumb || g.url}" alt="${g.title}" style="width:100%;height:100%;object-fit:cover;display:block;">
                </div>
            `).join('');
            info.innerHTML = `Powered by <a href="https://giphy.com" target="_blank" style="color:var(--accent,#7c3aed);">GIPHY</a>`;
            // Click to select
            grid.querySelectorAll('.giphy-thumb').forEach(el => {
                el.addEventListener('click', () => {
                    grid.querySelectorAll('.giphy-thumb').forEach(t => t.style.borderColor = 'transparent');
                    el.style.borderColor = 'var(--accent, #7c3aed)';
                    const url = el.dataset.url;
                    hiddenInput.value = url;
                    preview.src = url;
                    selectedWrap.style.display = 'block';
                });
            });
        } catch(e) { grid.innerHTML = '<div style="grid-column:1/-1;color:#f87171;font-size:.78rem;padding:12px;">Failed to search GIFs.</div>'; }
    }

    clearBtn.addEventListener('click', () => {
        hiddenInput.value = '';
        preview.src = '';
        selectedWrap.style.display = 'none';
        grid.querySelectorAll('.giphy-thumb').forEach(t => t.style.borderColor = 'transparent');
    });

    btn.addEventListener('click', searchGiphy);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); searchGiphy(); }});
})();
</script>
{% endblock %}
