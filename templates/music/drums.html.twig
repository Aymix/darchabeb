{% extends 'base.html.twig' %}
{% block title %}Acoustic Drums — VirtuArts{% endblock %}

{% block body %}
<div class="mus-page">
<div class="mus-topbar">
    <a href="{{ path('app_music_studio') }}" class="mus-back">← Acoustic Hub</a>
    <div class="mus-topbar-title"><span>🥁</span><span>Acoustic Drums</span></div>
    <div id="statusMsg" class="mus-status"></div>
</div>

<div class="instr-wrap">
    <div class="instr-controls">
        <div class="instr-hints">Tap the pads or hit the keyboard (<kbd>Q W E R</kbd> / <kbd>A S D F</kbd>).</div>
        <div class="instr-actions">
            <button id="btnRecord" class="instr-btn instr-btn-record">⏺ Record</button>
            <button id="btnPlay"   class="instr-btn instr-btn-play" disabled>▶ Play back</button>
            <button id="btnSave"   class="instr-btn instr-btn-save" disabled>💾 Save</button>
        </div>
    </div>

    <div id="aiFeedback" class="ai-feedback-bar" style="display:none;">
        <span class="ai-label">🤖 Rhythm Check</span>
        <span id="aiText">—</span>
    </div>

    {# Drum pads — 2×4 grid #}
    <div class="drum-kit" id="drumKit"></div>

    <div class="instr-info-bar">
        <span style="color:var(--color-text-muted);font-size:.85rem;">Hits:</span>
        <span id="hitsLog" class="notes-log">—</span>
    </div>
</div>
</div>
{% endblock %}

{% block page_scripts %}
<style>
.mus-page { background:#0d0d10; min-height:100vh; }
.mus-topbar { display:flex; align-items:center; gap:16px; padding:14px 28px; background:rgba(255,255,255,.03); border-bottom:1px solid rgba(255,255,255,.07); }
.mus-back { color:var(--color-text-muted); text-decoration:none; font-size:.85rem; } .mus-back:hover{color:var(--color-primary);}
.mus-topbar-title { display:flex; align-items:center; gap:10px; font-size:1.2rem; font-weight:800; color:#fff; margin-right:auto; }
.mus-status { font-size:.8rem; color:var(--color-primary); font-weight:600; }
.instr-wrap { padding:24px 32px; display:flex; flex-direction:column; gap:18px; }
.instr-controls { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; }
.instr-hints { font-size:.85rem; color:var(--color-text-muted); }
.instr-hints kbd { background:#1e1e28; border:1px solid #3a3a48; border-radius:5px; padding:2px 7px; font-size:.8rem; color:#ccc; }
.instr-actions { display:flex; gap:10px; }
.instr-btn { padding:8px 18px; border:none; border-radius:999px; font-size:.82rem; font-weight:700; cursor:pointer; transition:all .2s; }
.instr-btn-record { background:rgba(249,115,22,.15); color:var(--color-primary); border:1px solid rgba(249,115,22,.4); }
.instr-btn-record.recording { background:var(--color-primary); color:#fff; animation:recPulse 1s infinite; }
.instr-btn-play { background:rgba(34,197,94,.12); color:#4ade80; border:1px solid rgba(34,197,94,.3); }
.instr-btn-play:disabled,.instr-btn-save:disabled { opacity:.4; cursor:not-allowed; }
.instr-btn-save { background:rgba(59,130,246,.12); color:#60a5fa; border:1px solid rgba(59,130,246,.3); }
@keyframes recPulse { 0%,100%{opacity:1} 50%{opacity:.6} }
.ai-feedback-bar { background:rgba(234,179,8,.08); border:1px solid rgba(234,179,8,.25); border-radius:12px; padding:10px 16px; display:flex; align-items:center; gap:12px; font-size:.85rem; color:#fef3c7; }
.ai-label { background:rgba(234,179,8,.2); border-radius:999px; padding:2px 10px; font-weight:700; font-size:.75rem; color:#fbbf24; }

/* Drum kit */
.drum-kit { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; max-width:780px; margin:0 auto; }
.drum-pad {
    aspect-ratio:1.4;
    border-radius:16px; border:none; cursor:pointer;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
    font-size:1.1rem; font-weight:800; color:#fff; user-select:none;
    transition: all .08s;
    box-shadow: 0 6px 20px rgba(0,0,0,.5), inset 0 1px 2px rgba(255,255,255,.1);
}
.drum-pad .pad-key { font-size:.7rem; color:rgba(255,255,255,.45); font-weight:600; margin-top:2px; }
.drum-pad:hover { filter:brightness(1.15); transform:translateY(-2px); }
.drum-pad:active,.drum-pad.hit { transform:translateY(2px) scale(.96); filter:brightness(1.4); }

/* Pad colours by type */
.pad-kick   { background:linear-gradient(145deg,#2d1f3d,#1e1428); border:1px solid rgba(139,92,246,.3); }
.pad-snare  { background:linear-gradient(145deg,#1e2a3d,#141e2e); border:1px solid rgba(59,130,246,.3); }
.pad-hat    { background:linear-gradient(145deg,#2d2a1a,#1e1c10); border:1px solid rgba(234,179,8,.3); }
.pad-tom    { background:linear-gradient(145deg,#1e2d1e,#141e14); border:1px solid rgba(34,197,94,.3); }
.pad-kick.hit   { box-shadow:0 0 30px rgba(139,92,246,.5); }
.pad-snare.hit  { box-shadow:0 0 30px rgba(59,130,246,.5); }
.pad-hat.hit    { box-shadow:0 0 30px rgba(234,179,8,.5); }
.pad-tom.hit    { box-shadow:0 0 30px rgba(34,197,94,.5); }

.instr-info-bar { background:#111116; border:1px solid rgba(255,255,255,.07); border-radius:10px; padding:10px 16px; font-size:.82rem; color:#fff; display:flex; gap:10px; flex-wrap:wrap; align-items:center; min-height:40px; }
.notes-log { color:var(--color-primary); font-weight:600; font-family:monospace; }
</style>

<script>
(function(){
'use strict';
const AudioCtx = window.AudioContext || window.webkitAudioContext;
let audioCtx = null;

const PADS = [
  { name:'Kick',  key:'q', type:'kick',  cls:'pad-kick',  emoji:'🔵', row:0 },
  { name:'Snare', key:'w', type:'snare', cls:'pad-snare', emoji:'⚪', row:0 },
  { name:'Hat',   key:'e', type:'hat',   cls:'pad-hat',   emoji:'🟡', row:0 },
  { name:'Tom',   key:'r', type:'tom',   cls:'pad-tom',   emoji:'🟢', row:0 },
  { name:'Kick',  key:'a', type:'kick',  cls:'pad-kick',  emoji:'🔵', row:1 },
  { name:'Snare', key:'s', type:'snare', cls:'pad-snare', emoji:'⚪', row:1 },
  { name:'Hat',   key:'d', type:'hat',   cls:'pad-hat',   emoji:'🟡', row:1 },
  { name:'Tom',   key:'f', type:'tom',   cls:'pad-tom',   emoji:'🟢', row:1 },
];
const KEY_MAP = {};
PADS.forEach(p => KEY_MAP[p.key] = p);

/* Build drum kit */
const kit = document.getElementById('drumKit');
const padEls = [];
PADS.forEach(p => {
  const btn = document.createElement('button');
  btn.className = `drum-pad ${p.cls}`;
  btn.innerHTML = `<span>${p.name}</span><span class="pad-key">${p.key.toUpperCase()}</span>`;
  btn.addEventListener('mousedown', () => hitPad(p, btn));
  kit.appendChild(btn);
  padEls.push(btn);
});

/* Audio synthesis */
function hitPad(p, el) {
  if (!audioCtx) audioCtx = new AudioCtx();
  const now = audioCtx.currentTime;
  switch (p.type) {
    case 'kick': {
      const osc = audioCtx.createOscillator();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(160, now);
      osc.frequency.exponentialRampToValueAtTime(40, now + 0.3);
      const g = audioCtx.createGain();
      g.gain.setValueAtTime(1, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
      osc.connect(g).connect(audioCtx.destination);
      osc.start(now); osc.stop(now + 0.4);
      break;
    }
    case 'snare': {
      const buf = audioCtx.createBuffer(1, audioCtx.sampleRate*0.18, audioCtx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i=0;i<d.length;i++) d[i] = Math.random()*2-1;
      const src = audioCtx.createBufferSource(); src.buffer = buf;
      const g = audioCtx.createGain();
      g.gain.setValueAtTime(0.5, now); g.gain.exponentialRampToValueAtTime(0.001, now+0.18);
      const f = audioCtx.createBiquadFilter(); f.type='highpass'; f.frequency.value=800;
      src.connect(f).connect(g).connect(audioCtx.destination); src.start(now);
      const osc = audioCtx.createOscillator(); osc.type='triangle';
      osc.frequency.setValueAtTime(250,now); osc.frequency.exponentialRampToValueAtTime(100,now+0.1);
      const g2 = audioCtx.createGain(); g2.gain.setValueAtTime(0.4,now); g2.gain.exponentialRampToValueAtTime(0.001,now+0.12);
      osc.connect(g2).connect(audioCtx.destination); osc.start(now); osc.stop(now+0.12);
      break;
    }
    case 'hat': {
      const buf = audioCtx.createBuffer(1, audioCtx.sampleRate*0.06, audioCtx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i=0;i<d.length;i++) d[i] = Math.random()*2-1;
      const src = audioCtx.createBufferSource(); src.buffer = buf;
      const g = audioCtx.createGain();
      g.gain.setValueAtTime(0.25,now); g.gain.exponentialRampToValueAtTime(0.001,now+0.06);
      const f = audioCtx.createBiquadFilter(); f.type='highpass'; f.frequency.value=7000;
      src.connect(f).connect(g).connect(audioCtx.destination); src.start(now);
      break;
    }
    case 'tom': {
      const osc = audioCtx.createOscillator(); osc.type='sine';
      osc.frequency.setValueAtTime(180,now); osc.frequency.exponentialRampToValueAtTime(90,now+0.28);
      const g = audioCtx.createGain();
      g.gain.setValueAtTime(0.7,now); g.gain.exponentialRampToValueAtTime(0.001,now+0.3);
      osc.connect(g).connect(audioCtx.destination); osc.start(now); osc.stop(now+0.3);
      break;
    }
  }
  el.classList.add('hit'); setTimeout(()=>el.classList.remove('hit'),120);
  logHit(p.name);
  if (isRecording) captureHit(p.name);
  rhythmCheck();
}

/* Hit log */
let hitsArr = [];
function logHit(name) {
  hitsArr.push(name);
  if (hitsArr.length>16) hitsArr.shift();
  document.getElementById('hitsLog').textContent = hitsArr.join(' · ');
}

/* Keyboard */
const held = new Set();
document.addEventListener('keydown', e => {
  const k = e.key.toLowerCase();
  if (k === 'r' && !e.ctrlKey) { toggleRecord(); return; }
  if (held.has(k)) return;
  held.add(k);
  const idx = PADS.findIndex(p=>p.key===k);
  if (idx>=0) hitPad(PADS[idx], padEls[idx]);
});
document.addEventListener('keyup', e => held.delete(e.key.toLowerCase()));

/* Recording */
let isRecording=false, recStart=0, recEvents=[];
const btnRecord=document.getElementById('btnRecord');
const btnPlay=document.getElementById('btnPlay');
const btnSave=document.getElementById('btnSave');

function toggleRecord(){
  isRecording=!isRecording;
  if(isRecording){ recStart=Date.now(); recEvents=[]; btnRecord.textContent='⏹ Stop'; btnRecord.classList.add('recording'); setStatus('🔴 Recording…'); }
  else { btnRecord.textContent='⏺ Record'; btnRecord.classList.remove('recording');
    if(recEvents.length){btnPlay.disabled=false;btnSave.disabled=false;setStatus(`✅ Recorded ${recEvents.length} hits`);}
    else setStatus('');
  }
}
btnRecord.addEventListener('click', toggleRecord);
function captureHit(name){ recEvents.push({hit:name, t:Date.now()-recStart}); }

btnPlay.addEventListener('click', ()=>{
  setStatus('▶ Replaying…');
  recEvents.forEach(ev=>{
    const idx=PADS.findIndex(p=>p.name===ev.hit);
    setTimeout(()=>{ if(idx>=0) hitPad(PADS[idx],padEls[idx]); }, ev.t);
  });
  const dur=recEvents[recEvents.length-1]?.t??0;
  setTimeout(()=>setStatus(''), dur+500);
});

btnSave.addEventListener('click', async ()=>{
  const dur=Math.round((recEvents[recEvents.length-1]?.t??0)/1000);
  const res=await fetch('{{ path('app_music_recording_save') }}',{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({instrument:'drums',title:null,data:recEvents,duration:dur})
  });
  const json=await res.json();
  if(json.success){setStatus('💾 Saved as #'+json.id);btnSave.disabled=true;}
});

/* AI Rhythm Check */
let hitTimes=[];
const aiFeedback=document.getElementById('aiFeedback');
const aiText=document.getElementById('aiText');

function rhythmCheck(){
  hitTimes.push(Date.now());
  if(hitTimes.length>8) hitTimes.shift();
  aiFeedback.style.display='flex';
  if(hitTimes.length<4){ aiText.textContent='Keep playing to analyze your rhythm…'; return; }
  const gaps=[];
  for(let i=1;i<hitTimes.length;i++) gaps.push(hitTimes[i]-hitTimes[i-1]);
  const avg=gaps.reduce((a,b)=>a+b)/gaps.length;
  const variance=gaps.map(g=>Math.abs(g-avg)).reduce((a,b)=>a+b)/gaps.length;
  const bpm=Math.round(60000/avg);
  const score=Math.max(0,100-Math.round(variance/avg*100));
  const label=score>85?'🔥 Excellent!':score>70?'✅ Good':score>50?'⚠️ Getting there':'🎯 Work on consistency';
  aiText.textContent=`~${bpm} BPM · Accuracy: ${score}% ${label}`;
}

function setStatus(msg){ document.getElementById('statusMsg').textContent=msg; }
})();
</script>
{% endblock %}
