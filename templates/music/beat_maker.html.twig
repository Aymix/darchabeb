/* ═══════════════════════════════════════
   WAVEFORM VISUALIZER (hero canvas)
═══════════════════════════════════════ */
const waveCanvas = document.getElementById('waveformCanvas');
const wCtx = waveCanvas.getContext('2d');
let waveAnimId;

function resizeCanvas() {
    waveCanvas.width = waveCanvas.parentElement.offsetWidth;
    waveCanvas.height = waveCanvas.parentElement.offsetHeight;
}
resizeCanvas();
window.addEventListener('resize', resizeCanvas);

let wavePhase = 0;
function drawWave() {
    const W = waveCanvas.width, H = waveCanvas.height;
    wCtx.clearRect(0, 0, W, H);

    for (let layer = 0; layer < 3; layer++) {
        wCtx.beginPath();
        const alpha = 0.15 - layer * 0.04;
        const amp = 20 + layer * 10;
        const freq = 0.008 + layer * 0.003;
        const speed = 0.02 + layer * 0.01;

        wCtx.strokeStyle = `rgba(139, 92, 246, ${alpha})`;
        wCtx.lineWidth = 2;

        for (let x = 0; x <= W; x++) {
            const y = H / 2 + Math.sin(x * freq + wavePhase * speed + layer) * amp
                              + Math.sin(x * freq * 2.3 + wavePhase * speed * 1.5) * (amp * 0.3);
            if (x === 0) wCtx.moveTo(x, y);
            else wCtx.lineTo(x, y);
        }
        wCtx.stroke();
    }

    wavePhase++;
    waveAnimId = requestAnimationFrame(drawWave);
}
drawWave();

