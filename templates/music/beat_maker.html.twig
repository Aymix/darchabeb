{% extends 'base.html.twig' %}
{% block title %}Beat Maker — VirtuArts{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/aura-embed.css') }}">
{% endblock %}

{% block body %}
<div class="bm-page" id="bmPage">

    {# ── AMBIENT GLOWS ── #}
    <div class="bm-ambient">
        <div class="bm-glow bm-glow-1"></div>
        <div class="bm-glow bm-glow-2"></div>
        <div class="bm-glow bm-glow-3"></div>
    </div>

    {# ── TOPBAR ── #}
    <div class="bm-topbar">
        <a href="{{ path('app_music_studio') }}" class="bm-back"><i data-lucide="arrow-left"></i> Studio</a>
        <div class="bm-topbar-center">
            <span class="bm-topbar-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3ZM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3Z"/></svg></span>
            <span class="bm-topbar-title">Beat Maker</span>
            <span class="bm-topbar-badge">PRO</span>
        </div>
        <div id="statusMsg" class="bm-status"></div>
    </div>

    {# ── HERO WITH WAVEFORM ── #}
    <div class="bm-hero" id="bmHero">
        <canvas id="waveformCanvas" class="bm-waveform-canvas"></canvas>
        <div class="bm-hero-content">
            <h1 class="bm-hero-title">
                <span class="bm-hero-emoji"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="1.5"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3ZM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3Z"/></svg></span>
                Beat Maker Studio
            </h1>
            <p class="bm-hero-sub">Step sequencer · Custom instruments · AI co-creation · Export your beats</p>
            <div class="bm-hero-pills">
                <span class="bm-pill"><i data-lucide="drum" style="width:14px;height:14px;"></i> 8+ Tracks</span>
                <span class="bm-pill"><i data-lucide="plus-circle" style="width:14px;height:14px;"></i> Custom Sounds</span>
                <span class="bm-pill"><i data-lucide="download" style="width:14px;height:14px;"></i> Export WAV</span>
                <span class="bm-pill"><i data-lucide="sparkles" style="width:14px;height:14px;"></i> AI Assist</span>
            </div>
        </div>
    </div>

    {# ── MAIN LAYOUT: STUDIO + AI PANEL ── #}
    <div class="bm-main-layout">

        {# ── LEFT: STUDIO ── #}
        <div class="bm-studio-col">

            {# ── TRANSPORT CONTROLS ── #}
            <div class="bm-panel bm-transport-panel" id="bmTransport">
                <div class="bm-panel-glow"></div>
                <div class="bm-transport-row">
                    <div class="bm-transport-btns">
                        <button id="btnPlay" class="bm-ctrl-btn bm-ctrl-play" title="Play">
                            <i data-lucide="play" id="playIcon"></i>
                        </button>
                        <button id="btnStop" class="bm-ctrl-btn bm-ctrl-stop" title="Stop">
                            <i data-lucide="square"></i>
                        </button>
                        <button id="btnReset" class="bm-ctrl-btn bm-ctrl-ghost" title="Reset">
                            <i data-lucide="rotate-ccw"></i>
                        </button>
                    </div>

                    <div class="bm-tempo-section">
                        <label class="bm-label">TEMPO</label>
                        <input type="range" id="bpmSlider" min="60" max="200" value="120" class="bm-range">
                        <span id="bpmLabel" class="bm-tempo-val">120</span>
                        <span class="bm-tempo-unit">BPM</span>
                    </div>

                    <div class="bm-swing-section">
                        <label class="bm-label">SWING</label>
                        <input type="range" id="swingSlider" min="0" max="100" value="0" class="bm-range bm-range-sm">
                        <span id="swingLabel" class="bm-tempo-val">0%</span>
                    </div>
                </div>

                {# Presets #}
                <div class="bm-presets-row">
                    <span class="bm-label">PRESETS</span>
                    <button data-preset="rock" class="bm-preset-chip">🎸 Rock</button>
                    <button data-preset="hiphop" class="bm-preset-chip">🎤 Hip-Hop</button>
                    <button data-preset="edm" class="bm-preset-chip">🎧 EDM</button>
                    <button data-preset="reggae" class="bm-preset-chip">🌴 Reggae</button>
                    <button data-preset="jazz" class="bm-preset-chip">🎷 Jazz</button>
                    <button data-preset="lofi" class="bm-preset-chip">☁️ Lo-Fi</button>
                    <button data-preset="trap" class="bm-preset-chip">🔥 Trap</button>
                </div>
            </div>

            {# ── STEP SEQUENCER GRID ── #}
            <div class="bm-panel bm-grid-panel" id="bmGridPanel">
                <div class="bm-panel-glow"></div>

                {# Grid header #}
                <div class="bm-grid-scroll">
                    <div class="bm-grid-header" id="bmGridHeader">
                        <div class="bm-grid-label-spacer"></div>
                        {% for i in 1..16 %}
                        <div class="bm-step-num {{ i % 4 == 1 ? 'bar-start' : '' }}">{{ i }}</div>
                        {% endfor %}
                        <div class="bm-vol-label">VOL</div>
                        <div class="bm-mute-label">M</div>
                    </div>

                    {# Grid rows — built by JS #}
                    <div id="beatGrid" class="bm-grid-body"></div>

                    {# Add instrument button #}
                    <button id="btnAddInstrument" class="bm-add-instrument-btn">
                        <i data-lucide="plus"></i>
                        <span>Add Instrument</span>
                    </button>
                </div>

                {# Playhead bar #}
                <div class="bm-playbar">
                    <div id="playHead" class="bm-playhead"></div>
                </div>
            </div>

            {# ── ACTIONS ROW ── #}
            <div class="bm-panel bm-actions-panel" id="bmActions">
                <div class="bm-panel-glow"></div>

                <div class="bm-actions-left">
                    <input type="text" id="beatTitle" class="bm-title-input" placeholder="Beat title…">
                    <button id="btnSaveBeat" class="bm-action-btn bm-action-save">
                        <i data-lucide="save"></i> Save
                    </button>
                </div>

                <div class="bm-actions-right">
                    <button id="btnImport" class="bm-action-btn bm-action-ghost">
                        <i data-lucide="upload"></i> Import
                    </button>
                    <button id="btnExportJSON" class="bm-action-btn bm-action-ghost">
                        <i data-lucide="download"></i> JSON
                    </button>
                    <button id="btnExportWAV" class="bm-action-btn bm-action-accent">
                        <i data-lucide="file-audio"></i> WAV
                    </button>
                    <a href="{{ path('app_museum_submit', {module: 4}) }}" class="bm-action-btn bm-action-museum">
                        <i data-lucide="landmark"></i> Museum
                    </a>
                </div>
            </div>

            <div id="saveStatus" class="bm-save-status"></div>

            {# ━━━ FREESOUND SAMPLE BROWSER ━━━ #}
            <div class="bm-panel" id="bmFreesound">
                <div class="bm-panel-glow"></div>
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;position:relative;z-index:2;">
                    <span style="font-size:1rem;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14" opacity=".4"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07" opacity=".4"/></svg></span>
                    <span style="font-size:.82rem;font-weight:700;color:#fff;">Freesound Sample Browser</span>
                </div>
                <div style="display:flex;gap:6px;margin-bottom:10px;position:relative;z-index:2;">
                    <input type="text" id="fsQuery" class="bm-title-input" placeholder="Search sounds (e.g. 808 kick, hi-hat)…" style="flex:1;">
                    <button id="fsSearch" class="bm-action-btn bm-action-ghost" style="white-space:nowrap;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-1px"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg> Search</button>
                </div>
                <div id="fsResults" style="display:flex;flex-direction:column;gap:6px;max-height:200px;overflow-y:auto;position:relative;z-index:2;"></div>
                <div id="fsInfo" style="font-size:.6rem;color:rgba(255,255,255,.3);margin-top:6px;position:relative;z-index:2;"></div>
            </div>

            {# Hidden file input for import #}
            <input type="file" id="importFileInput" accept=".json" style="display:none;">
        </div>

        {# ── RIGHT: AI AURA PANEL ── #}
        <div class="bm-ai-col" id="bmAiPanel">
            <div class="bm-ai-header">
                <span class="bm-ai-dot"></span>
                <span>VirtuAi — Music Co-Creator</span>
                <button id="btnToggleAi" class="bm-ai-toggle" title="Toggle AI panel">
                    <i data-lucide="panel-right-close"></i>
                </button>
            </div>

            <div class="bm-ai-quick-actions">
                <button class="bm-ai-quick" data-suggest="Suggest a hip-hop beat pattern for my grid">🎤 Hip-Hop Beat</button>
                <button class="bm-ai-quick" data-suggest="Fill hi-hats with a groovy pattern">🥁 Fill Hi-Hats</button>
                <button class="bm-ai-quick" data-suggest="Suggest a chord progression for a chill lo-fi track">☁️ Lo-Fi Chords</button>
                <button class="bm-ai-quick" data-suggest="Add groove variation to make my beat more human">✨ Add Groove</button>
                <button class="bm-ai-quick" data-suggest="Suggest a bass line that complements a standard rock beat">🎸 Bass Line</button>
            </div>

            {% include 'components/_aura_panel.html.twig' with { module: 'music' } %}
        </div>

    </div>{# /bm-main-layout #}

</div>{# /bm-page #}

{# ── ADD INSTRUMENT MODAL ── #}
<div class="bm-modal-overlay" id="addInstModal" style="display:none;">
    <div class="bm-modal">
        <div class="bm-modal-header">
            <h3><i data-lucide="plus-circle"></i> Add Custom Instrument</h3>
            <button class="bm-modal-close" id="closeInstModal"><i data-lucide="x"></i></button>
        </div>
        <div class="bm-modal-body">
            <div class="bm-modal-field">
                <label>Instrument Name</label>
                <input type="text" id="instName" placeholder="e.g. Synth Pad" maxlength="20">
            </div>
            <div class="bm-modal-field">
                <label>Sound Source</label>
                <div class="bm-modal-tabs">
                    <button class="bm-modal-tab active" data-tab="synth">🎛️ Synthesizer</button>
                    <button class="bm-modal-tab" data-tab="sample">📁 Upload Sample</button>
                </div>
            </div>

            {# Synth options #}
            <div id="synthOptions" class="bm-modal-section">
                <div class="bm-modal-field">
                    <label>Waveform</label>
                    <div class="bm-wave-picker">
                        <button class="bm-wave-btn active" data-wave="sine">∿ Sine</button>
                        <button class="bm-wave-btn" data-wave="square">⊓ Square</button>
                        <button class="bm-wave-btn" data-wave="sawtooth">⟋ Saw</button>
                        <button class="bm-wave-btn" data-wave="triangle">△ Triangle</button>
                    </div>
                </div>
                <div class="bm-modal-row">
                    <div class="bm-modal-field">
                        <label>Frequency (Hz)</label>
                        <input type="number" id="instFreq" value="220" min="20" max="8000" step="1">
                    </div>
                    <div class="bm-modal-field">
                        <label>Decay (s)</label>
                        <input type="number" id="instDecay" value="0.3" min="0.05" max="2" step="0.05">
                    </div>
                </div>
                <button id="previewSynth" class="bm-action-btn bm-action-ghost" style="margin-top:8px;">
                    <i data-lucide="volume-2"></i> Preview Sound
                </button>
            </div>

            {# Sample upload #}
            <div id="sampleOptions" class="bm-modal-section" style="display:none;">
                <div class="bm-modal-field">
                    <label>Audio File (.wav, .mp3, .ogg)</label>
                    <div class="bm-file-drop" id="sampleDropZone">
                        <i data-lucide="upload-cloud" style="width:32px;height:32px;color:rgba(139,92,246,.6);"></i>
                        <span>Drop file here or click to browse</span>
                        <input type="file" id="sampleFileInput" accept=".wav,.mp3,.ogg" style="display:none;">
                    </div>
                    <div id="sampleFileName" class="bm-sample-name" style="display:none;"></div>
                </div>
            </div>

            <div class="bm-modal-field">
                <label>Color</label>
                <div class="bm-color-picker">
                    <button class="bm-color-swatch active" data-color="#e11d48" style="background:#e11d48;"></button>
                    <button class="bm-color-swatch" data-color="#f97316" style="background:#f97316;"></button>
                    <button class="bm-color-swatch" data-color="#eab308" style="background:#eab308;"></button>
                    <button class="bm-color-swatch" data-color="#22c55e" style="background:#22c55e;"></button>
                    <button class="bm-color-swatch" data-color="#0ea5e9" style="background:#0ea5e9;"></button>
                    <button class="bm-color-swatch" data-color="#8b5cf6" style="background:#8b5cf6;"></button>
                    <button class="bm-color-swatch" data-color="#ec4899" style="background:#ec4899;"></button>
                    <button class="bm-color-swatch" data-color="#14b8a6" style="background:#14b8a6;"></button>
                </div>
            </div>
        </div>
        <div class="bm-modal-footer">
            <button id="btnConfirmInst" class="bm-action-btn bm-action-save" style="width:100%;">
                <i data-lucide="plus"></i> Add to Sequencer
            </button>
        </div>
    </div>
</div>

{% endblock %}

{% block page_scripts %}
<style>
/* ═══════════════════════════════════════════════
   BEAT MAKER PRO — 3D GLASSMORPHIC DESIGN
═══════════════════════════════════════════════ */

/* ── Base ── */
.bm-page {
    background: #08080c;
    min-height: 100vh;
    padding-bottom: 60px;
    position: relative;
    overflow-x: hidden;
    font-family: 'Inter', -apple-system, sans-serif;
}

/* ── Ambient glows ── */
.bm-ambient { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.bm-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    animation: bmPulse 6s ease-in-out infinite;
}
.bm-glow-1 { top: -10%; left: 20%; width: 500px; height: 500px; background: rgba(139,92,246,0.08); }
.bm-glow-2 { bottom: -5%; right: 15%; width: 400px; height: 400px; background: rgba(6,182,212,0.06); animation-delay: 2s; }
.bm-glow-3 { top: 40%; left: 60%; width: 300px; height: 300px; background: rgba(217,70,239,0.05); animation-delay: 4s; }
@keyframes bmPulse { 0%,100%{opacity:.5;transform:scale(1)} 50%{opacity:1;transform:scale(1.1)} }

/* ── Topbar ── */
.bm-topbar {
    position: sticky; top: 0; z-index: 100;
    display: flex; align-items: center; gap: 16px;
    padding: 12px 28px;
    background: rgba(8,8,12,0.85);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
}
.bm-back {
    color: rgba(255,255,255,0.4); text-decoration: none;
    font-size: .82rem; font-weight: 600;
    display: flex; align-items: center; gap: 4px;
    transition: color .2s;
}
.bm-back:hover { color: #a78bfa; }
.bm-back svg { width: 14px; height: 14px; }
.bm-topbar-center {
    display: flex; align-items: center; gap: 10px;
    margin-right: auto;
}
.bm-topbar-icon { font-size: 1.3rem; }
.bm-topbar-title { font-size: 1.05rem; font-weight: 800; color: #fff; }
.bm-topbar-badge {
    font-size: .6rem; font-weight: 800; letter-spacing: .08em;
    background: linear-gradient(135deg, #7c3aed, #06b6d4);
    color: #fff; padding: 2px 8px; border-radius: 4px;
}
.bm-status { font-size: .78rem; color: #a78bfa; font-weight: 600; }

/* ── Hero ── */
.bm-hero {
    position: relative; text-align: center;
    padding: 56px 24px 44px; overflow: hidden;
}
.bm-waveform-canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    opacity: 0.4; pointer-events: none;
}
.bm-hero-content { position: relative; z-index: 2; }
.bm-hero-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 900; color: #fff;
    margin: 0 0 10px; display: flex;
    align-items: center; justify-content: center; gap: 14px;
}
.bm-hero-emoji { font-size: 2.4rem; }
.bm-hero-sub { color: rgba(255,255,255,0.45); font-size: .95rem; margin: 0 0 20px; }
.bm-hero-pills { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
.bm-pill {
    display: flex; align-items: center; gap: 6px;
    background: rgba(139,92,246,0.1); color: #c4b5fd;
    border: 1px solid rgba(139,92,246,0.2); border-radius: 999px;
    padding: 5px 14px; font-size: .78rem; font-weight: 600;
}

/* ── Main Layout ── */
.bm-main-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 20px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
}

/* ── Panels ── */
.bm-panel {
    position: relative;
    background: rgba(255,255,255,0.02);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 18px;
    padding: 20px;
    margin-bottom: 16px;
    overflow: hidden;
}
.bm-panel-glow {
    position: absolute; top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: radial-gradient(ellipse at 30% 20%, rgba(139,92,246,0.04), transparent 60%);
    pointer-events: none;
}

/* ── Transport ── */
.bm-transport-row {
    display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
    position: relative; z-index: 2;
}
.bm-transport-btns { display: flex; gap: 8px; }
.bm-ctrl-btn {
    width: 44px; height: 44px;
    border-radius: 12px; border: none;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all .2s; position: relative; overflow: hidden;
}
.bm-ctrl-btn svg { width: 18px; height: 18px; position: relative; z-index: 2; }
.bm-ctrl-play {
    background: rgba(139,92,246,0.15); color: #c4b5fd;
    border: 1px solid rgba(139,92,246,0.3);
}
.bm-ctrl-play:hover { background: rgba(139,92,246,0.3); }
.bm-ctrl-play.playing {
    background: linear-gradient(135deg, #7c3aed, #6d28d9);
    color: #fff; border-color: #7c3aed;
    box-shadow: 0 0 20px rgba(124,58,237,0.4);
}
.bm-ctrl-stop {
    background: rgba(239,68,68,0.1); color: #f87171;
    border: 1px solid rgba(239,68,68,0.2);
}
.bm-ctrl-stop:hover { background: rgba(239,68,68,0.2); }
.bm-ctrl-ghost {
    background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.5);
    border: 1px solid rgba(255,255,255,0.08);
}
.bm-ctrl-ghost:hover { background: rgba(255,255,255,0.08); color: #fff; }

.bm-label {
    font-size: .6rem; font-weight: 800; letter-spacing: .12em;
    text-transform: uppercase; color: rgba(255,255,255,0.35);
}
.bm-tempo-section, .bm-swing-section { display: flex; align-items: center; gap: 8px; }
.bm-range {
    width: 100px; height: 4px;
    -webkit-appearance: none; appearance: none;
    background: rgba(255,255,255,0.1); border-radius: 999px;
    outline: none; cursor: pointer;
}
.bm-range::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 14px; height: 14px; border-radius: 50%;
    background: #7c3aed; border: 2px solid #a78bfa;
    cursor: pointer; box-shadow: 0 0 8px rgba(124,58,237,0.5);
}
.bm-range-sm { width: 70px; }
.bm-tempo-val { font-size: 1.1rem; font-weight: 800; color: #c4b5fd; min-width: 32px; }
.bm-tempo-unit { font-size: .7rem; font-weight: 700; color: rgba(255,255,255,0.3); }

/* Presets */
.bm-presets-row {
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
    margin-top: 14px; padding-top: 14px;
    border-top: 1px solid rgba(255,255,255,0.04);
    position: relative; z-index: 2;
}
.bm-preset-chip {
    padding: 5px 12px; border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03); color: rgba(255,255,255,0.5);
    font-size: .75rem; font-weight: 600; cursor: pointer;
    transition: all .2s; font-family: 'Inter', sans-serif;
}
.bm-preset-chip:hover { background: rgba(139,92,246,0.15); border-color: rgba(139,92,246,0.3); color: #c4b5fd; }
.bm-preset-chip.active { background: rgba(139,92,246,0.25); border-color: #7c3aed; color: #e9d5ff; }

/* ── Grid ── */
.bm-grid-scroll { overflow-x: auto; position: relative; z-index: 2; }
.bm-grid-header, .beat-row {
    display: grid;
    grid-template-columns: 120px repeat(16, 38px) 56px 36px;
    gap: 3px;
    align-items: center;
}
.bm-grid-header { margin-bottom: 6px; }
.bm-grid-label-spacer { }
.bm-step-num {
    text-align: center; font-size: .6rem; font-weight: 700;
    color: rgba(255,255,255,0.2); padding-bottom: 4px;
}
.bm-step-num.bar-start { color: rgba(255,255,255,0.5); }
.bm-vol-label, .bm-mute-label {
    font-size: .55rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: .08em; color: rgba(255,255,255,0.25); text-align: center;
}

/* Beat row */
.beat-row { margin-bottom: 4px; }
.beat-row-label {
    font-size: .75rem; font-weight: 700; color: rgba(255,255,255,0.7);
    padding-right: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    display: flex; align-items: center; gap: 6px;
}
.beat-row-label .row-delete {
    opacity: 0; cursor: pointer; color: rgba(239,68,68,0.6);
