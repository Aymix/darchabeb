        const q = input.value.trim();
        if (!q) return;
        results.innerHTML = '<div style="text-align:center;padding:12px;color:rgba(255,255,255,.4);font-size:.78rem;">Searching…</div>';
        info.textContent = '';
        try {
            const res = await fetch(`{{ path('api_freesound_search') }}?q=${encodeURIComponent(q)}&page_size=8`);
            const data = await res.json();
            if (data.error) { results.innerHTML = `<div style="color:#f87171;font-size:.75rem;padding:8px;">${data.error}</div>`; return; }
            if (!data.results.length) { results.innerHTML = '<div style="text-align:center;padding:12px;color:rgba(255,255,255,.4);font-size:.78rem;">No samples found.</div>'; return; }
            results.innerHTML = data.results.map(s => `
                <div style="display:flex;align-items:center;gap:8px;padding:8px 10px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);border-radius:8px;transition:all .15s;cursor:pointer;"
                     onmouseover="this.style.borderColor='rgba(139,92,246,.3)'" onmouseout="this.style.borderColor='rgba(255,255,255,.06)'">
                    <button class="fs-play-btn" data-url="${s.preview_url}" style="width:30px;height:30px;border-radius:50%;border:1px solid rgba(139,92,246,.3);background:rgba(139,92,246,.1);color:#c4b5fd;font-size:.7rem;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;">▶</button>
                    <div style="flex:1;overflow:hidden;">
                        <div style="font-size:.78rem;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${s.name}</div>
                        <div style="font-size:.6rem;color:rgba(255,255,255,.3);">${s.duration}s · by ${s.author}</div>
                    </div>
                </div>
            `).join('');
            info.innerHTML = `${data.count} results from <a href="https://freesound.org" target="_blank" style="color:#a78bfa;">Freesound.org</a>`;
            // Attach play handlers
            results.querySelectorAll('.fs-play-btn').forEach(b => {
                b.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (currentAudio) { currentAudio.pause(); currentAudio = null; }
                    if (b.textContent === '⏹') { b.textContent = '▶'; return; }
                    results.querySelectorAll('.fs-play-btn').forEach(x => x.textContent = '▶');
                    currentAudio = new Audio(b.dataset.url);
                    currentAudio.play();
                    b.textContent = '⏹';
                    currentAudio.onended = () => { b.textContent = '▶'; currentAudio = null; };
                });
            });
        } catch(e) { results.innerHTML = '<div style="color:#f87171;font-size:.75rem;padding:8px;">Failed to search samples.</div>'; }
    }

    btn.addEventListener('click', searchFreesound);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') searchFreesound(); });
})();

// ══════════════════════════════════════════
// AURA AI BEAT MAKER BRIDGE
// ══════════════════════════════════════════
window.__auraLoadBeat = function(pattern, newBpm) {
    if (newBpm) {
        bpm = newBpm;
        const sl = document.getElementById('bpmSlider');
        const lb = document.getElementById('bpmLabel');
        if (sl) { sl.value = bpm; }
        if (lb) lb.textContent = bpm;
    }
    if (!pattern) return 0;
    let loaded = 0;
    TRACKS.forEach(t => {
        const steps = pattern[t.id];
        if (!steps || !Array.isArray(steps)) return;
        steps.forEach((v, s) => {
            if (s >= STEPS) return;
            grid[t.id][s] = !!v;
            if (cellEls[t.id] && cellEls[t.id][s]) {
                const cell = cellEls[t.id][s];
                cell.classList.toggle('on', !!v);
                if (!!v) {
                    cell.classList.add(t.colorClass || '');
                    if (t.color && !t.colorClass) {
                        cell.style.background = t.color;
                        cell.style.boxShadow = `0 0 14px ${t.color}66`;
                    }
                } else {
                    cell.classList.remove(t.colorClass || '');
                    cell.style.background = '';
                    cell.style.boxShadow = '';
                }
            }
        });
        loaded++;
    });
    return loaded;
};

window.__auraGetBeatState = function() {
    return { bpm, swing, grid, trackIds: TRACKS.map(t => t.id) };
};
</script>
{% endblock %}
