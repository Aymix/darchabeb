// Export WAV
document.getElementById('btnExportWAV').addEventListener('click', async () => {
    showStatus('⏳ Rendering WAV…');
    const sampleRate = 44100;
    const duration = (60 / bpm) * 4; // 1 bar
    const totalSamples = Math.ceil(sampleRate * duration);
    const offCtx = new OfflineAudioContext(1, totalSamples, sampleRate);

    for (let step = 0; step < STEPS; step++) {
        const stepTime = (60 / bpm / 4) * step;
        TRACKS.forEach(t => {
            if (!grid[t.id][step] || muted[t.id]) return;
            const vol = volumes[t.id] ?? 0.7;
            const freq = t.freq || 220;
            const decay = t.decay || 0.3;
            const wave = t.wave || 'sine';
            const g = offCtx.createGain(); g.connect(offCtx.destination);

            if (t.type === 'sample' && customSampleBuffers[t.id]) {
                const src = offCtx.createBufferSource(); src.buffer = customSampleBuffers[t.id];
                g.gain.setValueAtTime(vol, stepTime);
                src.connect(g); src.start(stepTime);
            } else if (wave === 'noise' || wave === 'noise-hi' || wave === 'clap') {
                const dur = decay;
                const buf = offCtx.createBuffer(1, sampleRate * dur, sampleRate);
                const d = buf.getChannelData(0);
                for (let i = 0; i < d.length; i++) d[i] = Math.random()*2-1;
                const src = offCtx.createBufferSource(); src.buffer = buf;
                const f = offCtx.createBiquadFilter(); f.type='highpass'; f.frequency.value = wave === 'noise-hi' ? 7000 : 900;
                g.gain.setValueAtTime(vol * 0.5, stepTime);
                g.gain.exponentialRampToValueAtTime(0.001, stepTime + dur);
                src.connect(f).connect(g); src.start(stepTime);
            } else {
                const osc = offCtx.createOscillator(); osc.type = wave;
                osc.frequency.setValueAtTime(freq, stepTime);
                if (t.id === 'kick' || t.id === 'tom') osc.frequency.exponentialRampToValueAtTime(Math.max(freq*0.2,30), stepTime+decay);
                g.gain.setValueAtTime(vol, stepTime);
                g.gain.exponentialRampToValueAtTime(0.001, stepTime+decay);
                osc.connect(g); osc.start(stepTime); osc.stop(stepTime+decay);
            }
        });
    }

    const rendered = await offCtx.startRendering();
    const wavBlob = audioBufferToWav(rendered);
    const a = document.createElement('a');
    a.href = URL.createObjectURL(wavBlob);
    a.download = (document.getElementById('beatTitle').value.trim() || 'beat') + '.wav';
    a.click();
    showStatus('✅ WAV exported!');
});

function audioBufferToWav(buffer) {
    const samples = buffer.getChannelData(0);
    const numSamples = samples.length;
    const bitsPerSample = 16;
    const byteRate = buffer.sampleRate * 2;
    const blockAlign = 2;
    const dataSize = numSamples * 2;
    const arrayBuf = new ArrayBuffer(44 + dataSize);
    const view = new DataView(arrayBuf);

    // WAV header
    writeString(view, 0, 'RIFF');
    view.setUint32(4, 36 + dataSize, true);
    writeString(view, 8, 'WAVE');
    writeString(view, 12, 'fmt ');
    view.setUint32(16, 16, true);
    view.setUint16(20, 1, true);
    view.setUint16(22, 1, true);
    view.setUint32(24, buffer.sampleRate, true);
    view.setUint32(28, byteRate, true);
    view.setUint16(32, blockAlign, true);
    view.setUint16(34, bitsPerSample, true);
    writeString(view, 36, 'data');
    view.setUint32(40, dataSize, true);

    let offset = 44;
    for (let i = 0; i < numSamples; i++) {
        const s = Math.max(-1, Math.min(1, samples[i]));
        view.setInt16(offset, s < 0 ? s * 0x8000 : s * 0x7FFF, true);
        offset += 2;
    }

    return new Blob([arrayBuf], { type: 'audio/wav' });

    function writeString(view, offset, str) {
        for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
    }
}

