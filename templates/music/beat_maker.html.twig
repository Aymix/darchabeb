{# ── GSAP for animations ── #}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

<script>
(function(){
'use strict';

/* ═══════════════════════════════════════
   AUDIO CONTEXT
═══════════════════════════════════════ */
const AudioCtx = window.AudioContext || window.webkitAudioContext;
let audioCtx = null;
function getCtx() { if (!audioCtx) audioCtx = new AudioCtx(); return audioCtx; }

/* ═══════════════════════════════════════
   TRACK DEFINITIONS
═══════════════════════════════════════ */
const DEFAULT_TRACKS = [
    { id:'kick',  label:'🔵 Kick',   colorClass:'color-violet',  type:'synth', wave:'sine',     freq:180, decay:0.4 },
    { id:'snare', label:'⚪ Snare',  colorClass:'color-blue',    type:'synth', wave:'noise',    freq:240, decay:0.18 },
    { id:'hihat', label:'🟡 Hi-Hat', colorClass:'color-amber',   type:'synth', wave:'noise-hi', freq:7000,decay:0.08 },
    { id:'tom',   label:'🟢 Tom',    colorClass:'color-emerald', type:'synth', wave:'sine',     freq:180, decay:0.28 },
    { id:'clap',  label:'👏 Clap',   colorClass:'color-red',     type:'synth', wave:'clap',     freq:1200,decay:0.1 },
    { id:'bass',  label:'🟣 Bass',   colorClass:'color-fuchsia', type:'synth', wave:'sawtooth', freq:80,  decay:0.35 },
    { id:'synth', label:'🔵 Synth',  colorClass:'color-cyan',    type:'synth', wave:'square',   freq:440, decay:0.2 },
    { id:'perc',  label:'🟩 Perc',   colorClass:'color-lime',    type:'synth', wave:'triangle', freq:600, decay:0.14 },
];

let TRACKS = [...DEFAULT_TRACKS];
const STEPS = 16;
let bpm = 120, swing = 0, isPlaying = false;
let grid = {}, volumes = {}, muted = {};
let stepIndex = 0, schedulerId = null;
let customSampleBuffers = {}; // id -> AudioBuffer

// Load custom instruments from localStorage
try {
    const saved = localStorage.getItem('bm_custom_tracks');
    if (saved) {
        const customs = JSON.parse(saved);
        customs.forEach(t => { t.custom = true; TRACKS.push(t); });
    }
} catch(e) {}

function initGrid() {
    TRACKS.forEach(t => {
        if (!grid[t.id]) grid[t.id] = Array(STEPS).fill(false);
        if (volumes[t.id] === undefined) volumes[t.id] = 0.8;
        if (muted[t.id] === undefined) muted[t.id] = false;
    });
}
initGrid();

/* ═══════════════════════════════════════
   BUILD GRID DOM
═══════════════════════════════════════ */
const gridEl = document.getElementById('beatGrid');
let cellEls = {};

function buildGrid() {
    gridEl.innerHTML = '';
    cellEls = {};

    TRACKS.forEach(t => {
        const row = document.createElement('div');
        row.className = 'beat-row';
        row.dataset.sound = t.id;

        // Label
        const lbl = document.createElement('div');
        lbl.className = 'beat-row-label';
        lbl.innerHTML = `<span>${t.label}</span>`;
        if (t.custom) {
            const del = document.createElement('button');
            del.className = 'row-delete custom-delete';
            del.innerHTML = '<i data-lucide="trash-2"></i>';
            del.addEventListener('click', () => removeCustomTrack(t.id));
            lbl.appendChild(del);
        }
        row.appendChild(lbl);

        // Cells
        cellEls[t.id] = [];
        for (let s = 0; s < STEPS; s++) {
            const cell = document.createElement('div');
            cell.className = 'beat-cell';
            if (grid[t.id][s]) cell.classList.add('on', t.colorClass || '');
            cell.addEventListener('click', () => {
                grid[t.id][s] = !grid[t.id][s];
                cell.classList.toggle('on', grid[t.id][s]);
                if (grid[t.id][s]) {
                    cell.classList.add(t.colorClass || '');
                    // Custom color
                    if (t.color && !t.colorClass) {
                        cell.style.background = t.color;
                        cell.style.boxShadow = `0 0 14px ${t.color}66`;
                    }
                } else {
                    cell.classList.remove(t.colorClass || '');
                    cell.style.background = '';
                    cell.style.boxShadow = '';
                }
            });
            row.appendChild(cell);
            cellEls[t.id].push(cell);
        }

        // Volume
        const vol = document.createElement('input');
        vol.type = 'range'; vol.min = '0'; vol.max = '1'; vol.step = '0.05';
        vol.value = String(volumes[t.id]); vol.className = 'beat-vol';
        vol.addEventListener('input', () => { volumes[t.id] = parseFloat(vol.value); });
        row.appendChild(vol);

        // Mute
        const muteBtn = document.createElement('button');
        muteBtn.className = 'beat-mute' + (muted[t.id] ? ' muted' : '');
        muteBtn.textContent = 'M';
        muteBtn.addEventListener('click', () => {
            muted[t.id] = !muted[t.id];
            muteBtn.classList.toggle('muted', muted[t.id]);
        });
        row.appendChild(muteBtn);

        gridEl.appendChild(row);
    });

    if (typeof lucide !== 'undefined') lucide.createIcons();
}
buildGrid();

/* ═══════════════════════════════════════
   BPM / SWING
═══════════════════════════════════════ */
document.getElementById('bpmSlider').addEventListener('input', e => {
    bpm = parseInt(e.target.value);
    document.getElementById('bpmLabel').textContent = bpm;
    if (isPlaying) { stop(); play(); }
});

document.getElementById('swingSlider').addEventListener('input', e => {
    swing = parseInt(e.target.value);
    document.getElementById('swingLabel').textContent = swing + '%';
});

/* ═══════════════════════════════════════
   TRANSPORT
═══════════════════════════════════════ */
const btnPlay = document.getElementById('btnPlay');
const btnStop = document.getElementById('btnStop');
const btnReset = document.getElementById('btnReset');
const playIcon = document.getElementById('playIcon');

function play() {
    if (isPlaying) return;
    getCtx().resume();
    isPlaying = true;
    btnPlay.classList.add('playing');
    playIcon.setAttribute('data-lucide', 'pause');
    if (typeof lucide !== 'undefined') lucide.createIcons();
    stepIndex = 0;
    tick();
    const baseMs = (60000 / bpm) / 4;
    schedulerId = setInterval(tick, baseMs);
}

function stop() {
    isPlaying = false;
    clearInterval(schedulerId);
    btnPlay.classList.remove('playing');
    playIcon.setAttribute('data-lucide', 'play');
    if (typeof lucide !== 'undefined') lucide.createIcons();
    TRACKS.forEach(t => cellEls[t.id]?.forEach(c => c.classList.remove('step-highlight')));
    document.getElementById('playHead').style.width = '0%';
}

btnPlay.addEventListener('click', () => { if (isPlaying) stop(); else play(); });
btnStop.addEventListener('click', stop);
btnReset.addEventListener('click', () => {
    stop();
    TRACKS.forEach(t => {
        grid[t.id] = Array(STEPS).fill(false);
        cellEls[t.id]?.forEach(c => {
            c.classList.remove('on', 'step-highlight');
            c.className = 'beat-cell';
            c.style.background = '';
            c.style.boxShadow = '';
        });
    });
    document.querySelectorAll('.bm-preset-chip').forEach(b => b.classList.remove('active'));
});

function tick() {
    TRACKS.forEach(t => {
        if (!cellEls[t.id]) return;
        const prev = (stepIndex - 1 + STEPS) % STEPS;
        cellEls[t.id][prev]?.classList.remove('step-highlight');
        cellEls[t.id][stepIndex]?.classList.add('step-highlight');
        if (grid[t.id][stepIndex] && !muted[t.id]) playSoundNow(t);
    });
    document.getElementById('playHead').style.width = ((stepIndex + 1) / STEPS * 100) + '%';
    stepIndex = (stepIndex + 1) % STEPS;
}

/* ═══════════════════════════════════════
   SOUND ENGINE
═══════════════════════════════════════ */
function playSoundNow(track) {
    const ctx = getCtx();
    const vol = volumes[track.id] ?? 0.7;
    const now = ctx.currentTime;

    // Custom sample
    if (track.type === 'sample' && customSampleBuffers[track.id]) {
        const src = ctx.createBufferSource();
        src.buffer = customSampleBuffers[track.id];
        const g = ctx.createGain();
        g.gain.setValueAtTime(vol, now);
        g.gain.exponentialRampToValueAtTime(0.001, now + (track.decay || 0.5));
        src.connect(g).connect(ctx.destination);
        src.start(now);
        return;
    }

    // Synth sounds
    const g = ctx.createGain();
    g.connect(ctx.destination);
    const freq = track.freq || 220;
    const decay = track.decay || 0.3;
    const wave = track.wave || 'sine';

    if (wave === 'noise' || wave === 'noise-hi') {
        const buf = ctx.createBuffer(1, ctx.sampleRate * decay, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
        const src = ctx.createBufferSource(); src.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'highpass'; f.frequency.value = wave === 'noise-hi' ? 7000 : 900;
        g.gain.setValueAtTime(vol * 0.5, now);
        g.gain.exponentialRampToValueAtTime(0.001, now + decay);
        src.connect(f).connect(g); src.start(now);
        // Add body tone for snare
        if (wave === 'noise') {
            const osc = ctx.createOscillator(); osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, now);
            osc.frequency.exponentialRampToValueAtTime(80, now + 0.12);
            const g2 = ctx.createGain();
            g2.gain.setValueAtTime(vol * 0.35, now);
            g2.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
            osc.connect(g2).connect(ctx.destination);
            osc.start(now); osc.stop(now + 0.12);
        }
    } else if (wave === 'clap') {
        [0, 0.01, 0.02].forEach(offset => {
            const buf = ctx.createBuffer(1, ctx.sampleRate * 0.1, ctx.sampleRate);
            const d = buf.getChannelData(0);
            for (let i = 0; i < d.length; i++) d[i] = (Math.random()*2-1) * Math.exp(-i/(ctx.sampleRate*0.03));
            const src = ctx.createBufferSource(); src.buffer = buf;
            const f = ctx.createBiquadFilter(); f.type='bandpass'; f.frequency.value=freq; f.Q.value=0.7;
            const gi = ctx.createGain(); gi.gain.setValueAtTime(vol*0.5, now+offset);
            src.connect(f).connect(gi).connect(ctx.destination); src.start(now+offset);
        });
    } else {
        // Standard oscillator
        const osc = ctx.createOscillator();
        osc.type = wave;
        if (track.id === 'kick' || track.id === 'tom') {
            osc.frequency.setValueAtTime(freq, now);
            osc.frequency.exponentialRampToValueAtTime(Math.max(freq * 0.2, 30), now + decay);
        } else {
            osc.frequency.setValueAtTime(freq, now);
        }
        if (track.id === 'bass') {
            const f = ctx.createBiquadFilter(); f.type='lowpass'; f.frequency.value=300;
            g.gain.setValueAtTime(vol*0.6, now);
            g.gain.exponentialRampToValueAtTime(0.001, now+decay);
            osc.connect(f).connect(g);
        } else if (track.id === 'synth') {
            const f = ctx.createBiquadFilter(); f.type='lowpass'; f.frequency.value=800;
            g.gain.setValueAtTime(vol*0.3, now);
            g.gain.exponentialRampToValueAtTime(0.001, now+decay);
            osc.connect(f).connect(g);
        } else {
            g.gain.setValueAtTime(vol, now);
            g.gain.exponentialRampToValueAtTime(0.001, now+decay);
            osc.connect(g);
        }
        osc.start(now); osc.stop(now+decay);
    }
}

