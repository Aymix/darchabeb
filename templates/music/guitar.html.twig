{% extends 'base.html.twig' %}
{% block title %}Acoustic Guitar — VirtuArts{% endblock %}

{% block body %}
<div class="mus-page">
<div class="mus-topbar">
    <a href="{{ path('app_music_studio') }}" class="mus-back">← Acoustic Hub</a>
    <div class="mus-topbar-title"><span>🎸</span><span>Acoustic Guitar</span></div>
    <div id="statusMsg" class="mus-status"></div>
</div>

<div class="instr-wrap">
    <div class="instr-controls">
        <div class="instr-hints">Click a chord to strum it, or press <kbd>1</kbd>–<kbd>8</kbd>.</div>
        <div class="instr-actions">
            <button id="btnRecord" class="instr-btn instr-btn-record">⏺ Record</button>
            <button id="btnPlay"   class="instr-btn instr-btn-play" disabled>▶ Play back</button>
            <button id="btnSave"   class="instr-btn instr-btn-save" disabled>💾 Save</button>
        </div>
    </div>

    <div id="aiFeedback" class="ai-feedback-bar" style="display:none;">
        <span class="ai-label">🤖 AI</span>
        <span id="aiText">—</span>
    </div>

    {# Guitar neck decoration #}
    <div class="guitar-neck-wrap">
        <div class="guitar-neck">
            <div class="guitar-nut"></div>
            {% for _ in 1..5 %}<div class="guitar-fret"></div>{% endfor %}
            <div class="guitar-strings-wrap">
                {% for _ in 1..6 %}<div class="guitar-str"></div>{% endfor %}
            </div>
        </div>
    </div>

    {# Chord pads #}
    <div class="guitar-chords" id="chordGrid"></div>

    <div class="instr-info-bar">
        <span style="color:var(--color-text-muted);font-size:.85rem;">Last chord:</span>
        <span id="lastChord" class="notes-log">—</span>
        &nbsp;&nbsp;
        <span style="color:var(--color-text-muted);font-size:.85rem;">Sequence:</span>
        <span id="chordSeq" class="notes-log">—</span>
    </div>
</div>
</div>
{% endblock %}

{% block page_scripts %}
<style>
.mus-page { background:#0d0d10; min-height:100vh; }
.mus-topbar { display:flex; align-items:center; gap:16px; padding:14px 28px; background:rgba(255,255,255,.03); border-bottom:1px solid rgba(255,255,255,.07); }
.mus-back { color:var(--color-text-muted); text-decoration:none; font-size:.85rem; } .mus-back:hover { color:var(--color-primary); }
.mus-topbar-title { display:flex; align-items:center; gap:10px; font-size:1.2rem; font-weight:800; color:#fff; margin-right:auto; }
.mus-status { font-size:.8rem; color:var(--color-primary); font-weight:600; }
.instr-wrap { padding:24px 32px; display:flex; flex-direction:column; gap:18px; }
.instr-controls { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; }
.instr-hints { font-size:.85rem; color:var(--color-text-muted); }
.instr-hints kbd { background:#1e1e28; border:1px solid #3a3a48; border-radius:5px; padding:2px 7px; font-size:.8rem; color:#ccc; }
.instr-actions { display:flex; gap:10px; }
.instr-btn { padding:8px 18px; border:none; border-radius:999px; font-size:.82rem; font-weight:700; cursor:pointer; transition:all .2s; }
.instr-btn-record { background:rgba(249,115,22,.15); color:var(--color-primary); border:1px solid rgba(249,115,22,.4); }
.instr-btn-record.recording { background:var(--color-primary); color:#fff; animation:recPulse 1s infinite; }
.instr-btn-play { background:rgba(34,197,94,.12); color:#4ade80; border:1px solid rgba(34,197,94,.3); }
.instr-btn-play:disabled,.instr-btn-save:disabled { opacity:.4; cursor:not-allowed; }
.instr-btn-save { background:rgba(59,130,246,.12); color:#60a5fa; border:1px solid rgba(59,130,246,.3); }
@keyframes recPulse { 0%,100%{opacity:1} 50%{opacity:.6} }
.ai-feedback-bar { background:rgba(34,197,94,.08); border:1px solid rgba(34,197,94,.2); border-radius:12px; padding:10px 16px; display:flex; align-items:center; gap:12px; font-size:.85rem; color:#d1fae5; }
.ai-label { background:rgba(34,197,94,.2); border-radius:999px; padding:2px 10px; font-weight:700; font-size:.75rem; color:#4ade80; }

/* Guitar neck */
.guitar-neck-wrap { display:flex; justify-content:center; padding:8px 0; }
.guitar-neck {
    width: min(700px, 100%); height: 80px;
    background: linear-gradient(180deg, #5c3a1a 0%, #3d2510 100%);
    border-radius: 12px; position: relative; overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,.6), inset 0 2px 4px rgba(255,255,255,.1);
}
.guitar-nut { position:absolute; left:0; top:0; bottom:0; width:8px; background:#d4c5a0; }
.guitar-fret { position:absolute; top:0; bottom:0; width:2px; background:rgba(200,180,120,.3); }
.guitar-fret:nth-child(2)  { left:20%; }
.guitar-fret:nth-child(3)  { left:40%; }
.guitar-fret:nth-child(4)  { left:55%; }
.guitar-fret:nth-child(5)  { left:70%; }
.guitar-fret:nth-child(6)  { left:83%; }
.guitar-strings-wrap { position:absolute; top:0; left:0; right:0; bottom:0; display:flex; flex-direction:column; justify-content:space-evenly; padding:4px 0; }
.guitar-str { height:1px; background:linear-gradient(90deg, rgba(210,180,140,.8), rgba(180,150,100,.4)); margin: 0 8px; }
.guitar-str:nth-child(1) { height:3px; }
.guitar-str:nth-child(2) { height:2.5px; }
.guitar-str:nth-child(3) { height:2px; }

/* Chord grid */
.guitar-chords { display:flex; gap:10px; flex-wrap:wrap; justify-content:center; }
.chord-btn {
    width:110px; height:110px;
    background: linear-gradient(145deg, #8B5E3C, #6B4422);
    border-radius:16px; border:none; cursor:pointer;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
    color:#fff; font-weight:800; font-size:1.4rem;
    box-shadow: 0 6px 20px rgba(0,0,0,.5), inset 0 1px 2px rgba(255,255,255,.15);
    transition: all .12s; user-select:none;
}
.chord-btn .chord-key { font-size:.7rem; color:rgba(255,255,255,.5); font-weight:600; }
.chord-btn:hover { background: linear-gradient(145deg, #a06a42, #7a4e26); transform:translateY(-2px); box-shadow:0 8px 28px rgba(0,0,0,.6); }
.chord-btn:active, .chord-btn.strummed { background: linear-gradient(145deg, #c8a060, #a07040); transform:translateY(2px) scale(.96); box-shadow:0 2px 8px rgba(0,0,0,.5); }

.instr-info-bar { background:#111116; border:1px solid rgba(255,255,255,.07); border-radius:10px; padding:10px 16px; font-size:.82rem; color:#fff; display:flex; gap:10px; flex-wrap:wrap; align-items:center; min-height:40px; }
.notes-log { color:var(--color-primary); font-weight:600; font-family:monospace; }
</style>

<script>
(function(){
'use strict';
const AudioCtx = window.AudioContext || window.webkitAudioContext;
let audioCtx = null;

const CHORDS = [
  { name:'C',  key:'1', freqs:[261.63,329.63,392.00,523.25] },
  { name:'G',  key:'2', freqs:[196.00,246.94,293.66,392.00] },
  { name:'Am', key:'3', freqs:[220.00,261.63,329.63,440.00] },
  { name:'F',  key:'4', freqs:[174.61,261.63,349.23,440.00] },
  { name:'D',  key:'5', freqs:[293.66,369.99,440.00,587.33] },
  { name:'Em', key:'6', freqs:[164.81,246.94,329.63,392.00] },
  { name:'A',  key:'7', freqs:[220.00,277.18,329.63,440.00] },
  { name:'Dm', key:'8', freqs:[293.66,349.23,440.00,587.33] },
];
const KEY_MAP = {};
CHORDS.forEach(c => KEY_MAP[c.key] = c);

/* Build chord grid */
const grid = document.getElementById('chordGrid');
const chordEls = {};
CHORDS.forEach(ch => {
  const btn = document.createElement('button');
  btn.className = 'chord-btn';
  btn.innerHTML = `<span>${ch.name}</span><span class="chord-key">${ch.key}</span>`;
  btn.addEventListener('mousedown', () => strum(ch));
  grid.appendChild(btn);
  chordEls[ch.name] = btn;
});

/* Strum */
function strum(ch) {
  if (!audioCtx) audioCtx = new AudioCtx();
  ch.freqs.forEach((f, i) => {
    setTimeout(() => {
      const now = audioCtx.currentTime;
      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(0.25, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 1.2);

      const osc = audioCtx.createOscillator();
      osc.type = 'sawtooth';
      osc.frequency.value = f;

      const filter = audioCtx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.value = 2000;
      filter.Q.value = 1;

      osc.connect(filter).connect(gain).connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 1.3);
    }, i * 30);
  });

  const el = chordEls[ch.name];
  if (el) { el.classList.add('strummed'); setTimeout(() => el.classList.remove('strummed'), 220); }
  logChord(ch.name);
  if (isRecording) captureChord(ch.name);
  suggestNext(ch.name);
}

/* Chord log */
let seqArr = [];
function logChord(name) {
  document.getElementById('lastChord').textContent = name;
  seqArr.push(name);
  if (seqArr.length > 12) seqArr.shift();
  document.getElementById('chordSeq').textContent = seqArr.join(' ');
}

/* Keyboard */
const held = new Set();
document.addEventListener('keydown', e => {
  if (held.has(e.key)) return;
  held.add(e.key);
  if (e.key === 'r') { toggleRecord(); return; }
  if (KEY_MAP[e.key]) strum(KEY_MAP[e.key]);
});
document.addEventListener('keyup', e => held.delete(e.key));

/* Recording */
let isRecording = false, recStart = 0, recEvents = [];
const btnRecord = document.getElementById('btnRecord');
const btnPlay   = document.getElementById('btnPlay');
const btnSave   = document.getElementById('btnSave');

function toggleRecord() {
  isRecording = !isRecording;
  if (isRecording) {
    recStart = Date.now(); recEvents = [];
    btnRecord.textContent = '⏹ Stop'; btnRecord.classList.add('recording');
    setStatus('🔴 Recording…');
  } else {
    btnRecord.textContent = '⏺ Record'; btnRecord.classList.remove('recording');
    if (recEvents.length) { btnPlay.disabled = false; btnSave.disabled = false; setStatus(`✅ Recorded ${recEvents.length} chords`); }
    else setStatus('');
  }
}
btnRecord.addEventListener('click', toggleRecord);
function captureChord(name) { recEvents.push({ chord: name, t: Date.now() - recStart }); }

/* Playback */
btnPlay.addEventListener('click', () => {
  setStatus('▶ Replaying…');
  recEvents.forEach(ev => { setTimeout(() => { const c = CHORDS.find(x=>x.name===ev.chord); if(c) strum(c); }, ev.t); });
  const dur = recEvents[recEvents.length-1]?.t ?? 0;
  setTimeout(() => setStatus(''), dur + 500);
});

/* Save */
btnSave.addEventListener('click', async () => {
  const dur = Math.round((recEvents[recEvents.length-1]?.t ?? 0) / 1000);
  const res = await fetch('{{ path('app_music_recording_save') }}', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ instrument:'guitar', title:null, data:recEvents, duration:dur })
  });
  const json = await res.json();
  if (json.success) { setStatus('💾 Saved as #' + json.id); btnSave.disabled = true; }
});

/* AI chord suggestions */
const PROG = {
  'C':['F','Am','G'],'G':['Em','C','D'],'Am':['F','C','G'],
  'F':['C','Dm','G'],'D':['G','A','Em'],'Em':['C','G','Am'],
  'A':['D','E','F#m'],'Dm':['Am','C','Gm'],
};
const aiFeedback = document.getElementById('aiFeedback');
const aiText = document.getElementById('aiText');

function suggestNext(chord) {
  aiFeedback.style.display = 'flex';
  const suggestions = PROG[chord] || [];
  aiText.textContent = suggestions.length
    ? `After ${chord}, try: ${suggestions.slice(0,3).join(' → ')}`
    : 'Try any chord — build your progression!';
}

function setStatus(msg) { document.getElementById('statusMsg').textContent = msg; }
})();
</script>
{% endblock %}
