{% extends 'base.html.twig' %}
{% block title %}My Recordings — VirtuArts{% endblock %}

{% block body %}
<div class="mus-page">
<div class="mus-topbar">
    <a href="{{ path('app_music_studio') }}" class="mus-back">← Acoustic Hub</a>
    <div class="mus-topbar-title"><span>🎙️</span><span>My Recordings</span></div>
    <a href="{{ path('app_music_tracks') }}" class="mus-top-link">💿 Community Tracks →</a>
</div>

<div class="rec-wrap">

    {% if recordings is empty %}
        <div class="rec-empty">
            <div class="rec-empty-icon">🎙️</div>
            <h2>No recordings yet</h2>
            <p>Play an instrument and hit <strong>💾 Save</strong> to keep your music here.</p>
            <div class="rec-empty-actions">
                <a href="{{ path('app_music_piano') }}"  class="rec-goto">🎹 Piano</a>
                <a href="{{ path('app_music_guitar') }}" class="rec-goto">🎸 Guitar</a>
                <a href="{{ path('app_music_drums') }}"  class="rec-goto">🥁 Drums</a>
            </div>
        </div>
    {% else %}
        <div class="rec-grid">
            {% for rec in recordings %}
            <div class="rec-card">
                <div class="rec-card-icon">{{ rec.instrumentEmoji }}</div>
                <div class="rec-card-body">
                    <h3 class="rec-title">{{ rec.title ?? 'Recording #' ~ rec.id }}</h3>
                    <p class="rec-meta">
                        {{ rec.instrument|capitalize }} instrument
                        {% if rec.durationSeconds %} · {{ rec.durationSeconds }}s{% endif %}
                    </p>
                    <p class="rec-date">{{ rec.createdAt|date('Y-m-d H:i') }}</p>
                </div>

                {# Actions #}
                <div class="rec-card-actions">
                    {# Publish to community #}
                    <button class="rec-btn rec-btn-publish"
                            onclick="openPublishModal({{ rec.id }}, '{{ rec.title ?? 'Recording #' ~ rec.id }}', '{{ rec.instrument }}')">
                        📢 Publish
                    </button>

                    {# Submit to museum #}
                    <a href="{{ path('app_museum_submit', {module: ''}) }}?type=music&title={{ (rec.title ?? 'Recording #' ~ rec.id)|url_encode }}"
                       class="rec-btn rec-btn-museum">🏛️ Museum</a>

                    {# Delete #}
                    <form method="post" action="{{ path('app_music_recording_delete', {id: rec.id}) }}"
                          onsubmit="return confirm('Delete this recording?')">
                        <button type="submit" class="rec-btn rec-btn-delete">🗑️</button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>
    {% endif %}

</div>

{# Publish Modal #}
<div id="publishModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <h2 class="modal-title">📢 Publish Track</h2>
        <form method="post" action="{{ path('app_music_track_publish') }}">
            <input type="hidden" id="pubRecId" name="recording_id" value="">
            <div class="modal-field">
                <label>Track Title</label>
                <input type="text" id="pubTitle" name="title" class="modal-input" placeholder="My awesome track">
            </div>
            <div class="modal-field">
                <label>Genre</label>
                <input type="text" id="pubGenre" name="genre" class="modal-input" placeholder="e.g. Jazz, Pop, Classical">
            </div>
            <div class="modal-field">
                <label>BPM (optional)</label>
                <input type="number" name="bpm" class="modal-input" placeholder="120" min="40" max="220">
            </div>
            <div class="modal-field-check">
                <input type="checkbox" id="pubPublic" name="is_public" value="1">
                <label for="pubPublic">Share with the community (make public)</label>
            </div>
            <div class="modal-actions">
                <button type="button" onclick="closePublishModal()" class="modal-btn modal-btn-cancel">Cancel</button>
                <button type="submit" class="modal-btn modal-btn-publish">🚀 Publish</button>
            </div>
        </form>
    </div>
</div>

</div>
{% endblock %}

{% block page_scripts %}
<style>
.mus-page { background:#0d0d10; min-height:100vh; }
.mus-topbar { display:flex; align-items:center; gap:16px; padding:14px 28px; background:rgba(255,255,255,.03); border-bottom:1px solid rgba(255,255,255,.07); }
.mus-back { color:var(--color-text-muted); text-decoration:none; font-size:.85rem; } .mus-back:hover{color:var(--color-primary);}
.mus-topbar-title { display:flex; align-items:center; gap:10px; font-size:1.15rem; font-weight:800; color:#fff; margin-right:auto; }
.mus-top-link { color:var(--color-primary); text-decoration:none; font-size:.82rem; font-weight:600; }
.mus-top-link:hover { text-decoration:underline; }

.rec-wrap { padding:28px 32px; }

/* Empty state */
.rec-empty { text-align:center; padding:60px 20px; }
.rec-empty-icon { font-size:4rem; margin-bottom:16px; }
.rec-empty h2 { font-size:1.4rem; font-weight:800; color:#fff; margin-bottom:8px; }
.rec-empty p { color:var(--color-text-muted); margin-bottom:24px; }
.rec-empty-actions { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
.rec-goto { padding:10px 22px; border-radius:12px; background:rgba(249,115,22,.12); border:1px solid rgba(249,115,22,.3); color:var(--color-primary); text-decoration:none; font-weight:700; transition:all .2s; }
.rec-goto:hover { background:rgba(249,115,22,.22); }

/* Recordings grid */
.rec-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:16px; }
.rec-card {
    background:#16161c; border:1px solid rgba(255,255,255,.07); border-radius:18px;
    padding:20px; display:flex; flex-direction:column; gap:12px;
    transition: all .2s;
}
.rec-card:hover { border-color:rgba(249,115,22,.3); box-shadow:0 8px 30px rgba(249,115,22,.1); }
.rec-card-icon { font-size:2.6rem; }
.rec-title { font-size:1rem; font-weight:700; color:#fff; margin-bottom:3px; }
.rec-meta  { font-size:.8rem; color:var(--color-text-muted); }
.rec-date  { font-size:.75rem; color:#555; font-weight:700; }

.rec-card-actions { display:flex; gap:8px; flex-wrap:wrap; margin-top:4px; }
.rec-btn { padding:7px 14px; border-radius:999px; border:none; cursor:pointer; font-size:.78rem; font-weight:700; text-decoration:none; display:inline-flex; align-items:center; transition:all .2s; }
.rec-btn-publish { background:rgba(249,115,22,.15); color:var(--color-primary); border:1px solid rgba(249,115,22,.3); }
.rec-btn-publish:hover { background:rgba(249,115,22,.3); }
.rec-btn-museum  { background:rgba(139,92,246,.12); color:#c4b5fd; border:1px solid rgba(139,92,246,.3); }
.rec-btn-museum:hover { background:rgba(139,92,246,.25); }
.rec-btn-delete  { background:rgba(239,68,68,.1); color:#f87171; border:1px solid rgba(239,68,68,.3); margin-left:auto; }
.rec-btn-delete:hover { background:rgba(239,68,68,.2); }

/* Modal */
.modal-overlay {
    position:fixed; inset:0; background:rgba(0,0,0,.75); z-index:9999;
    display:flex; align-items:center; justify-content:center; padding:20px;
}
.modal-box {
    background:#1a1a24; border:1px solid rgba(255,255,255,.12); border-radius:20px;
    padding:28px; width:100%; max-width:420px;
}
.modal-title { font-size:1.2rem; font-weight:800; color:#fff; margin-bottom:20px; }
.modal-field { display:flex; flex-direction:column; gap:6px; margin-bottom:14px; }
.modal-field label { font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--color-text-muted); }
.modal-input { background:#111116; border:1px solid rgba(255,255,255,.1); border-radius:10px; color:#fff; padding:9px 13px; font-size:.9rem; outline:none; transition:border-color .2s; }
.modal-input:focus { border-color:rgba(249,115,22,.5); }
.modal-field-check { display:flex; align-items:center; gap:10px; margin-bottom:18px; font-size:.85rem; color:var(--color-text-muted); }
.modal-actions { display:flex; gap:10px; justify-content:flex-end; }
.modal-btn { padding:9px 22px; border-radius:10px; border:none; cursor:pointer; font-weight:700; font-size:.88rem; transition:all .2s; }
.modal-btn-cancel  { background:rgba(255,255,255,.07); color:var(--color-text-muted); }
.modal-btn-publish { background:var(--color-primary); color:#fff; }
.modal-btn-publish:hover { background:var(--color-primary-dark); }
</style>

<script>
function openPublishModal(id, title, instrument) {
  document.getElementById('pubRecId').value  = id;
  document.getElementById('pubTitle').value  = title;
  document.getElementById('publishModal').style.display = 'flex';
}
function closePublishModal() {
  document.getElementById('publishModal').style.display = 'none';
}
document.getElementById('publishModal').addEventListener('click', function(e) {
  if (e.target === this) closePublishModal();
});
</script>
{% endblock %}
