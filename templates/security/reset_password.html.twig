{% extends 'base.html.twig' %}

{% block title %}Reset Password — VirtuArts{% endblock %}

{% block body %}
<div class="auth-page">
    <canvas data-shader class="auth-shader"></canvas>
    <div class="auth-card">
        <div class="auth-header">
            <span class="auth-icon"><i data-lucide="shield-check" style="width:48px;height:48px;color:var(--accent);"></i></span>
            <h1>Reset Your Password</h1>
            <p>Create a new password for <strong>{{ user.email }}</strong></p>
        </div>

        <form method="post" action="{{ path('app_reset_password', {token: token}) }}" class="auth-form" id="resetForm">
            <div class="form-group">
                <label for="inputPassword">New Password</label>
                <input type="password" id="inputPassword" name="password" required
                       placeholder="Minimum 6 characters" autocomplete="new-password" minlength="6">
            </div>

            <div class="form-group">
                <label for="inputPasswordConfirm">Confirm Password</label>
                <input type="password" id="inputPasswordConfirm" name="password_confirm" required
                       placeholder="Re-enter your new password" autocomplete="new-password" minlength="6">
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="resetButton">
                <i data-lucide="check-circle" class="btn-icon"></i> Reset Password
            </button>
        </form>

        <div class="auth-footer">
            <a href="{{ path('app_login') }}" class="back-link"><i data-lucide="arrow-left" class="btn-icon"></i> Back to Sign In</a>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
    if (typeof lucide !== 'undefined') { lucide.createIcons(); }
</script>
{% endblock %}
