{% extends 'base.html.twig' %}

{% block title %}Forgot Password — VirtuArts{% endblock %}

{% block body %}
<div class="auth-page">
    <canvas data-shader class="auth-shader"></canvas>
    <div class="auth-card">
        <div class="auth-header">
            <span class="auth-icon"><i data-lucide="key-round" style="width:48px;height:48px;color:var(--accent);"></i></span>
            <h1>Forgot Password</h1>
            <p>Enter your email address and we'll help you reset your password</p>
        </div>

        <form method="post" class="auth-form" id="forgotForm">
            <div class="form-group">
                <label for="inputEmail">Email Address</label>
                <input type="email" id="inputEmail" name="email" required autofocus
                       placeholder="you@example.com" autocomplete="email">
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="forgotButton">
                <i data-lucide="send" class="btn-icon"></i> Send Reset Link
            </button>
        </form>

        <div class="auth-footer">
            <p>Remember your password? <a href="{{ path('app_login') }}">Sign in</a></p>
            <a href="{{ path('app_home') }}" class="back-link"><i data-lucide="arrow-left" class="btn-icon"></i> Back to Home</a>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
    if (typeof lucide !== 'undefined') { lucide.createIcons(); }
</script>
{% endblock %}
