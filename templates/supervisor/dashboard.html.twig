{% extends 'base.html.twig' %}
{% block title %}Supervisor Dashboard — VirtuArts{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/dashboard-3d.css') }}">
{% endblock %}

{% block body %}
<div class="db3-page">
    <div class="db3-bg"></div>
    <div class="db3-container">

        {# ── FLASH MESSAGES ── #}
        {% for type, messages in app.flashes %}
        <div class="db3-flash-wrap">
            {% for msg in messages %}
            <div class="db3-flash {{ type }}">
                <i data-lucide="{{ type == 'success' ? 'check-circle' : (type == 'error' ? 'x-circle' : 'alert-triangle') }}"></i>
                {{ msg }}
            </div>
            {% endfor %}
        </div>
        {% endfor %}

        {# ── HEADER ── #}
        <div class="db3-header">
            <div class="db3-header-left">
                <h1>Supervisor Dashboard</h1>
                <p>Review submissions, manage users and platform modules</p>
            </div>
            <div class="db3-header-badge">
                <i data-lucide="shield"></i>
                SUPERVISOR
            </div>
        </div>

        {# ── STAT BAR ── #}
        <div class="db3-gam-bar">
            <div class="db3-gam-item">
                <span class="db3-gam-label"><i data-lucide="clock"></i> Pending</span>
                <span class="db3-gam-value" style="color:#f59e0b;" data-count="{{ pendingCount }}">{{ pendingCount }}</span>
            </div>
            <div class="db3-gam-item">
                <span class="db3-gam-label"><i data-lucide="check-circle"></i> Accepted</span>
                <span class="db3-gam-value" style="color:#4ade80;" data-count="{{ acceptedCount }}">{{ acceptedCount }}</span>
            </div>
            <div class="db3-gam-item">
                <span class="db3-gam-label"><i data-lucide="x-circle"></i> Refused</span>
                <span class="db3-gam-value" style="color:#f87171;" data-count="{{ refusedCount }}">{{ refusedCount }}</span>
            </div>
            <div class="db3-gam-item">
                <span class="db3-gam-label"><i data-lucide="bot"></i> AI Approved</span>
                <span class="db3-gam-value" style="color:#a78bfa;" data-count="{{ aiApprovedCount }}">{{ aiApprovedCount }}</span>
            </div>
            <div class="db3-gam-item">
                <span class="db3-gam-label"><i data-lucide="users"></i> Users</span>
                <span class="db3-gam-value">{{ users|length }}</span>
            </div>
            <div class="db3-gam-item">
                <span class="db3-gam-label"><i data-lucide="package"></i> Modules</span>
                <span class="db3-gam-value">{{ modules|length }}</span>
            </div>
        </div>

        {# ── TAB NAVIGATION ── #}
        <div class="db3-tabs" id="supTabs">
            <button class="db3-tab active" onclick="showTab('submissions', this)">
                <i data-lucide="clipboard-list"></i> Submissions
            </button>
            <button class="db3-tab" onclick="showTab('users', this)">
                <i data-lucide="users"></i> Users
            </button>
            <button class="db3-tab" onclick="showTab('modules', this)">
                <i data-lucide="package"></i> Modules
            </button>
        </div>

        {# ════════════════════════════════════════
           TAB 1 — SUBMISSIONS
        ════════════════════════════════════════ #}
        <div id="tab-submissions" class="db3-tab-panel active">

            <div class="db3-section-title db3-reveal">
                <div class="db3-section-icon"><i data-lucide="clock"></i></div>
                <h2>Pending Reviews</h2>
                <div class="db3-section-line"></div>
            </div>

            {% if pendingSubmissions is empty %}
                <div class="db3-empty db3-reveal">
                    <i data-lucide="party-popper"></i>
                    <p>All caught up! No pending submissions.</p>
                </div>
            {% else %}
                <div class="db3-sub-list">
                {% for sub in pendingSubmissions %}
                <div class="db3-sub-card db3-reveal">
                    <div class="db3-sub-thumb">
                        {% if sub.imagePath %}
                            <img src="{{ sub.imagePath }}" alt="{{ sub.title }}">
                        {% else %}
                            <i data-lucide="image"></i>
                        {% endif %}
                    </div>
                    <div class="db3-sub-info">
                        <h3>{{ sub.title ?? 'Untitled' }}</h3>
                        <div class="db3-sub-meta">
                            <i data-lucide="user"></i> {{ sub.user ? sub.user.fullName : 'Unknown' }}
                            <span style="color:#3a3a3a;">·</span>
                            <i data-lucide="package"></i> {{ sub.module ? sub.module.name : '—' }}
                            <span style="color:#3a3a3a;">·</span>
                            <i data-lucide="calendar"></i> {{ sub.submittedAt ? sub.submittedAt|date('d/m/Y H:i') : '—' }}
                        </div>
                        <span class="db3-status pending">{{ sub.status }}</span>
                        {% if sub.supervisorNote and sub.supervisorNote starts with '🤖' %}
                            <div style="margin-top:8px;padding:8px 12px;background:rgba(167,139,250,0.08);border:1px solid rgba(167,139,250,0.2);border-radius:8px;font-size:0.8rem;color:#c4b5fd;">
                                {{ sub.supervisorNote }}
                            </div>
                        {% endif %}
                    </div>
                    <div class="db3-sub-actions">
                        <form method="post" action="{{ path('app_supervisor_submission_accept', {id: sub.id}) }}" class="db3-sub-action-form">
                            <input type="text" name="supervisor_note" placeholder="Optional note…">
                            <button type="submit" class="db3-btn db3-btn-success db3-btn-sm" style="width:100%;">
                                <i data-lucide="check"></i> Accept
                            </button>
                        </form>
                        <form method="post" action="{{ path('app_supervisor_submission_refuse', {id: sub.id}) }}" class="db3-sub-action-form" style="margin-top:8px;">
                            <input type="text" name="supervisor_note" placeholder="Reason for refusal…">
                            <button type="submit" class="db3-btn db3-btn-danger db3-btn-sm" style="width:100%;">
                                <i data-lucide="x"></i> Refuse
                            </button>
                        </form>
                    </div>
                </div>
                {% endfor %}
                </div>
            {% endif %}

            {# All Submissions History #}
            <div class="db3-section-title db3-reveal" style="margin-top:48px;">
                <div class="db3-section-icon"><i data-lucide="scroll-text"></i></div>
                <h2>All Submissions History</h2>
                <div class="db3-section-line"></div>
            </div>

            {% if allSubmissions is empty %}
                <div class="db3-empty db3-reveal"><i data-lucide="inbox"></i><p>No submissions yet.</p></div>
            {% else %}
            <div class="db3-table-wrap db3-reveal">
                <table class="db3-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Title</th>
                            <th>Type</th>
                            <th>User</th>
                            <th>Module</th>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th>AI</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for sub in allSubmissions %}
                    <tr>
                        <td class="td-dim">{{ sub.id }}</td>
                        <td class="td-bold">{{ sub.title ?? '—' }}</td>
                        <td>{{ sub.type ?? '—' }}</td>
                        <td>{{ sub.user ? sub.user.fullName : '—' }}</td>
                        <td>{{ sub.module ? sub.module.name : '—' }}</td>
                        <td class="td-dim">{{ sub.submittedAt ? sub.submittedAt|date('d/m/Y') : '—' }}</td>
                        <td><span class="db3-status {{ sub.status|lower }}">{{ sub.status }}</span></td>
                        <td>
                            {% if sub.aiAutoApproved %}
                                <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;background:linear-gradient(135deg,rgba(167,139,250,0.15),rgba(139,92,246,0.10));border:1px solid rgba(167,139,250,0.3);border-radius:20px;font-size:0.72rem;font-weight:700;color:#c4b5fd;white-space:nowrap;">
                                    🤖 AI Approved
                                </span>
                            {% else %}
                                <span class="td-dim" style="font-size:0.72rem;">Manual</span>
                            {% endif %}
                        </td>
                        <td class="td-dim" style="max-width:140px;">{{ sub.supervisorNote ?? '—' }}</td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>

        {# ════════════════════════════════════════
           TAB 2 — USERS
        ════════════════════════════════════════ #}
        <div id="tab-users" class="db3-tab-panel">

            <div class="db3-section-title db3-reveal">
                <div class="db3-section-icon"><i data-lucide="users"></i></div>
                <h2>User Management</h2>
                <div class="db3-section-line"></div>
            </div>

            <div class="db3-search db3-reveal">
                <i data-lucide="search"></i>
                <input type="text" id="userSearchInput" placeholder="Search by name or email…" oninput="filterUserTable()">
            </div>

            {% if users is empty %}
                <div class="db3-empty db3-reveal"><i data-lucide="users"></i><p>No users found.</p></div>
            {% else %}
            <div class="db3-table-wrap db3-reveal">
                <table class="db3-table" id="userTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Level / XP</th>
                            <th>Status</th>
                            <th>Block Reason</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                    <tr class="{{ user.blocked ? 'row-blocked' : '' }}">
                        <td class="td-dim">{{ user.id }}</td>
                        <td class="td-bold">{{ user.fullName }}</td>
                        <td class="td-mono">{{ user.email }}</td>
                        <td>
                            <span class="db3-role {{ user.role|lower|default('user') }}">
                                {{ user.role ?? 'USER' }}
                            </span>
                        </td>
                        <td>
                            <span style="color:#f97316;font-weight:700;">Lv.{{ user.level }}</span>
                            <span class="td-dim"> / {{ user.xp }} XP</span>
                        </td>
                        <td>
                            {% if user.blocked %}
                                <span class="db3-status blocked"><i data-lucide="lock"></i>Blocked</span>
                            {% else %}
                                <span class="db3-status active"><i data-lucide="circle-check"></i>Active</span>
                            {% endif %}
                        </td>
                        <td class="td-dim" style="max-width:150px;font-size:0.76rem;">
                            {{ user.blockReason ?? '—' }}
                        </td>
                        <td>
                            {% if user.role|upper != 'SUPERVISEUR' and user.role|upper != 'ADMIN' %}
                                {% if user.blocked %}
                                    <form method="post" action="{{ path('app_supervisor_user_toggle_block', {id: user.id}) }}">
                                        <button type="submit" class="db3-btn db3-btn-success db3-btn-sm">
                                            <i data-lucide="lock-open"></i> Unblock
                                        </button>
                                    </form>
                                {% else %}
                                    <button type="button" class="db3-btn db3-btn-danger db3-btn-sm"
                                            onclick="openBlockModal({{ user.id }}, '{{ user.fullName|e('js') }}')">
                                        <i data-lucide="lock"></i> Block
                                    </button>
                                {% endif %}
                            {% else %}
                                <span style="font-size:0.73rem;color:#57534e;font-weight:600;">Protected</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>

        {# ════════════════════════════════════════
           TAB 3 — MODULES
        ════════════════════════════════════════ #}
        <div id="tab-modules" class="db3-tab-panel">

            <div class="db3-section-title db3-reveal">
                <div class="db3-section-icon"><i data-lucide="package"></i></div>
                <h2>Module Management</h2>
                <div class="db3-section-line"></div>
            </div>

            {% if modules is empty %}
                <div class="db3-empty db3-reveal"><i data-lucide="package"></i><p>No modules found.</p></div>
            {% else %}
            <div class="db3-table-wrap db3-reveal">
                <table class="db3-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Icon</th>
                            <th>Module Name</th>
                            <th>Supervisor</th>
                            <th>Status</th>
                            <th>Workshop</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for module in modules %}
                    <tr style="{{ module.isActive ? '' : 'opacity:.5;' }}">
                        <td class="td-dim">{{ module.id }}</td>
                        <td style="font-size:1.5rem;">{{ module.emoji }}</td>
                        <td class="td-bold">{{ module.name }}</td>
                        <td>{{ module.supervisorName }}</td>
                        <td>
                            <span class="db3-status {{ module.isActive ? 'active' : 'blocked-mod' }}">
                                {{ module.status }}
                            </span>
                        </td>
                        <td>
                            {% if module.hasWorkshopSchedule() %}
                                <span style="color:#f59e0b;font-weight:700;font-size:0.78rem;">
                                    📅 {{ module.workshopDay }} · {{ module.workshopTime }}
                                </span>
                            {% else %}
                                <span class="td-dim" style="font-size:0.76rem;">Not set</span>
                            {% endif %}
                        </td>
                        <td style="display:flex;gap:6px;align-items:center;">
                            <form method="post" action="{{ path('app_supervisor_module_toggle_block', {id: module.id}) }}">
                                {% if module.isActive %}
                                    <button type="submit" class="db3-btn db3-btn-danger db3-btn-sm">
                                        <i data-lucide="lock"></i> Block
                                    </button>
                                {% else %}
                                    <button type="submit" class="db3-btn db3-btn-success db3-btn-sm">
                                        <i data-lucide="check-circle"></i> Activate
                                    </button>
                                {% endif %}
                            </form>
                            <button type="button" class="db3-btn db3-btn-ghost db3-btn-sm"
                                    onclick="openWorkshopModal({{ module.id }}, '{{ module.name|e('js') }}', '{{ module.workshopDay|default('')|e('js') }}', '{{ module.workshopTime|default('')|e('js') }}', '{{ module.workshopDescription|default('')|e('js') }}')">
                                <i data-lucide="calendar-clock"></i> Workshop
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>

    </div>{# /db3-container #}
</div>{# /db3-page #}

{# ── BLOCK USER MODAL ── #}
<div class="db3-modal-overlay" id="blockModal" style="display:none;">
    <div class="db3-modal">
        <div class="db3-modal-header">
            <h3><i data-lucide="shield-alert"></i> Block User</h3>
            <button class="db3-modal-close" onclick="closeBlockModal()">&times;</button>
        </div>
        <div class="db3-modal-body">
            <p>You are about to block <strong id="blockUserName" style="color:#f5f5f4;"></strong>.</p>
            <p>This will prevent them from accessing their account. They will receive an email notification. Please provide a reason:</p>
            <form method="post" id="blockForm" action="">
                <div class="db3-form-group" style="margin-bottom:16px;">
                    <label><i data-lucide="message-square"></i> Reason <span style="color:#ef4444;">*</span></label>
                    <textarea id="blockReason" name="block_reason" rows="3"
                              placeholder="Explain why this user is being blocked…" required minlength="10"
                              style="resize:vertical;"></textarea>
                </div>
                <label class="db3-modal-confirm">
                    <input type="checkbox" id="blockConfirmCheck" required>
                    I confirm I want to block this user and notify them by email
                </label>
                <div class="db3-modal-footer">
                    <button type="button" class="db3-btn db3-btn-ghost" onclick="closeBlockModal()">Cancel</button>
                    <button type="submit" class="db3-btn db3-btn-danger" id="blockSubmitBtn" disabled>
                        <i data-lucide="lock"></i> Block &amp; Notify
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{# ── WORKSHOP SCHEDULE MODAL ── #}
<div class="db3-modal-overlay" id="workshopModal" style="display:none;">
    <div class="db3-modal">
        <div class="db3-modal-header" style="background:rgba(245,158,11,0.06);">
            <h3 style="color:#f59e0b;"><i data-lucide="calendar-clock"></i> Workshop Schedule</h3>
            <button class="db3-modal-close" onclick="closeWorkshopModal()">&times;</button>
        </div>
        <div class="db3-modal-body">
            <p>Set the weekly workshop schedule for <strong id="workshopModuleName" style="color:#f5f5f4;"></strong>:</p>
            <form method="post" id="workshopForm" action="">
                <div class="db3-form-row">
                    <div class="db3-form-group">
                        <label><i data-lucide="calendar-days"></i> Day of the Week</label>
                        <select name="workshop_day" id="workshopDay">
                            <option value="">— Select —</option>
                            <option value="Monday">Monday</option>
                            <option value="Tuesday">Tuesday</option>
                            <option value="Wednesday">Wednesday</option>
                            <option value="Thursday">Thursday</option>
                            <option value="Friday">Friday</option>
                            <option value="Saturday">Saturday</option>
                            <option value="Sunday">Sunday</option>
                        </select>
                    </div>
                    <div class="db3-form-group">
                        <label><i data-lucide="clock"></i> Time</label>
                        <input type="time" name="workshop_time" id="workshopTime" value="">
                    </div>
                </div>
                <div class="db3-form-group" style="margin-bottom:16px;">
                    <label><i data-lucide="message-square"></i> Description (optional)</label>
                    <textarea name="workshop_description" id="workshopDesc" rows="2"
                              placeholder="What will this workshop cover?"></textarea>
                </div>
                <div class="db3-modal-footer" style="padding:16px 0 0;border:none;">
                    <button type="button" class="db3-btn db3-btn-ghost" onclick="closeWorkshopModal()">Cancel</button>
                    <button type="submit" class="db3-btn db3-btn-primary">
                        <i data-lucide="save"></i> Save Schedule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="{{ asset('js/dashboard-3d.js') }}"></script>
<script>
/* Tab switching */
function showTab(name, btn) {
    document.querySelectorAll('.db3-tab-panel').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.db3-tab').forEach(el => el.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    btn.classList.add('active');
    if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
}

/* Auto-open tab from URL hash */
(function() {
    const hash = window.location.hash.replace('#','');
    if (['submissions','users','modules'].includes(hash)) {
        const btn = document.querySelector(`.db3-tab[onclick*="${hash}"]`);
        if (btn) showTab(hash, btn);
    }
})();

/* User search */
function filterUserTable() {
    const q = document.getElementById('userSearchInput').value.toLowerCase();
    document.querySelectorAll('#userTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}

/* Block modal */
function openBlockModal(userId, userName) {
    document.getElementById('blockUserName').textContent = userName;
    document.getElementById('blockForm').action = '/supervisor/user/' + userId + '/toggle-block';
    document.getElementById('blockReason').value = '';
    document.getElementById('blockConfirmCheck').checked = false;
    document.getElementById('blockSubmitBtn').disabled = true;
    const modal = document.getElementById('blockModal');
    modal.style.display = 'flex';
    if (typeof lucide !== 'undefined') lucide.createIcons();
    if (typeof gsap !== 'undefined') {
        gsap.from('.db3-modal', { duration: 0.4, scale: 0.94, opacity: 0, y: 20, ease: 'back.out(1.5)' });
    }
}
function closeBlockModal() {
    document.getElementById('blockModal').style.display = 'none';
}
document.getElementById('blockConfirmCheck')?.addEventListener('change', function() {
    document.getElementById('blockSubmitBtn').disabled = !this.checked;
});
document.getElementById('blockModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeBlockModal();
});

/* Workshop modal */
function openWorkshopModal(moduleId, moduleName, day, time, desc) {
    document.getElementById('workshopModuleName').textContent = moduleName;
    document.getElementById('workshopForm').action = '/supervisor/module/' + moduleId + '/workshop';
    document.getElementById('workshopDay').value = day || '';
    document.getElementById('workshopTime').value = time || '';
    document.getElementById('workshopDesc').value = desc || '';
    const modal = document.getElementById('workshopModal');
    modal.style.display = 'flex';
    if (typeof lucide !== 'undefined') lucide.createIcons();
    if (typeof gsap !== 'undefined') {
        gsap.from('#workshopModal .db3-modal', { duration: 0.4, scale: 0.94, opacity: 0, y: 20, ease: 'back.out(1.5)' });
    }
}
function closeWorkshopModal() {
    document.getElementById('workshopModal').style.display = 'none';
}
document.getElementById('workshopModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeWorkshopModal();
});

if (typeof lucide !== 'undefined') lucide.createIcons();
</script>
{% endblock %}
