{% extends 'email/base_email.html.twig' %}

{% block subject %}Reset Your VirtuArts Password{% endblock %}

{% block body %}
    <p>Hello <strong>{{ user.fullName }}</strong>,</p>

    <p>We received a request to reset the password for your VirtuArts account associated with <strong>{{ user.email }}</strong>.</p>

    <p>Click the button below to create a new password:</p>

    <div style="text-align: center;">
        <a href="{{ resetUrl }}" class="email-btn">Reset My Password</a>
    </div>

    <div class="email-info-box">
        <div class="label">Link expires in</div>
        <div class="value">{{ expiresIn }}</div>
    </div>

    <p class="text-muted">If you did not request a password reset, you can safely ignore this email. Your password will remain unchanged.</p>

    <div class="email-divider"></div>

    <p class="text-muted">If the button above doesn't work, copy and paste this URL into your browser:</p>
    <p style="word-break: break-all; font-size: 13px; color: #f97316;">{{ resetUrl }}</p>
{% endblock %}
