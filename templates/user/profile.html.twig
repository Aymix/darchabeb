{% extends 'base.html.twig' %}
{% block title %}My Profile — VirtuArts{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/dashboard-3d.css') }}">
{% endblock %}

{% block body %}
<div class="db3-page">
    <div class="db3-bg"></div>
    <div class="db3-container">

        {# ── FLASH MESSAGES ── #}
        {% for type, messages in app.flashes %}
        <div class="db3-flash-wrap">
            {% for msg in messages %}
            <div class="db3-flash {{ type }}">
                <i data-lucide="{{ type == 'success' ? 'check-circle' : (type == 'error' ? 'x-circle' : 'alert-triangle') }}"></i>
                {{ msg }}
            </div>
            {% endfor %}
        </div>
        {% endfor %}

        {# ── HEADER ── #}
        <div class="db3-header">
            <div class="db3-header-left">
                <h1>My Profile</h1>
                <p>Manage your account settings, art name, and security</p>
            </div>
            <a href="{{ path('app_user_dashboard') }}" class="db3-btn db3-btn-ghost">
                <i data-lucide="arrow-left"></i> Dashboard
            </a>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">

            {# ── AVATAR & IDENTITY ── #}
            <div class="db3-form-card">
                <div class="db3-section-title" style="margin-bottom:24px;">
                    <div class="db3-section-icon"><i data-lucide="user"></i></div>
                    <h2>Identity & Avatar</h2>
                </div>

                <form method="post" action="{{ path('app_user_profile_update') }}" enctype="multipart/form-data">
                    {# Avatar preview #}
                    <div style="display:flex;align-items:center;gap:20px;margin-bottom:24px;">
                        <div style="width:80px;height:80px;border-radius:50%;overflow:hidden;border:2px solid rgba(249,115,22,0.3);display:flex;align-items:center;justify-content:center;background:rgba(249,115,22,0.08);font-size:2rem;font-weight:800;color:#f97316;flex-shrink:0;">
                            {% if app.user.avatarPath %}
                                <img src="{{ app.user.avatarPath }}" alt="Avatar" style="width:100%;height:100%;object-fit:cover;">
                            {% else %}
                                {{ app.user.firstName|slice(0,1)|upper }}
                            {% endif %}
                        </div>
                        <div class="db3-form-group" style="flex:1;">
                            <label><i data-lucide="camera"></i> Change Avatar</label>
                            <input type="file" name="avatar" accept="image/*">
                        </div>
                    </div>

                    <div class="db3-form-row">
                        <div class="db3-form-group">
                            <label><i data-lucide="user"></i> First Name</label>
                            <input type="text" name="first_name" value="{{ app.user.firstName }}" required minlength="2" maxlength="30">
                        </div>
                        <div class="db3-form-group">
                            <label><i data-lucide="user"></i> Last Name</label>
                            <input type="text" name="last_name" value="{{ app.user.lastName }}" required minlength="2" maxlength="30">
                        </div>
                    </div>

                    <div class="db3-form-group" style="margin-bottom:20px;">
                        <label><i data-lucide="palette"></i> Art Name / Display Name</label>
                        <input type="text" name="display_name" value="{{ app.user.displayName }}" placeholder="Leave empty to use your real name" maxlength="100">
                        <span style="font-size:0.72rem;color:#57534e;">This name will be shown publicly instead of your real name</span>
                    </div>

                    <button type="submit" class="db3-btn db3-btn-primary" style="width:100%;justify-content:center;">
                        <i data-lucide="save"></i> Save Changes
                    </button>
                </form>
            </div>

            {# ── ACCOUNT INFO & SECURITY ── #}
            <div>
                {# Account Info Card #}
                <div class="db3-form-card" style="margin-bottom:24px;">
                    <div class="db3-section-title" style="margin-bottom:24px;">
                        <div class="db3-section-icon"><i data-lucide="info"></i></div>
                        <h2>Account Info</h2>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:12px;">
                        <div style="display:flex;justify-content:space-between;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;">
                            <span style="font-size:0.78rem;color:#78716c;font-weight:700;">Email</span>
                            <span style="font-size:0.84rem;color:#d6d3d1;font-family:monospace;">{{ app.user.email }}</span>
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;">
                            <span style="font-size:0.78rem;color:#78716c;font-weight:700;">Role</span>
                            <span class="db3-role {{ app.user.role|lower|default('user') }}">{{ app.user.role|default('USER') }}</span>
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;">
                            <span style="font-size:0.78rem;color:#78716c;font-weight:700;">Level</span>
                            <span style="color:#f97316;font-weight:800;">Lv.{{ app.user.level }} <span style="color:#78716c;font-weight:400;">({{ app.user.xp }} XP)</span></span>
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;">
                            <span style="font-size:0.78rem;color:#78716c;font-weight:700;">Points</span>
                            <span style="color:#f59e0b;font-weight:800;">{{ app.user.points }} ⭐</span>
                        </div>
                    </div>
                </div>

                {# Password Change Card #}
                <div class="db3-form-card">
                    <div class="db3-section-title" style="margin-bottom:24px;">
                        <div class="db3-section-icon"><i data-lucide="lock"></i></div>
                        <h2>Change Password</h2>
                    </div>
                    <p style="font-size:0.84rem;color:#a8a29e;line-height:1.6;margin:0 0 16px;">
                        For security, password changes require email verification. Click the button below and we'll send a verification link to <strong style="color:#d6d3d1;">{{ app.user.email }}</strong>.
                    </p>
                    <form method="post" action="{{ path('app_user_request_password_change') }}">
                        <button type="submit" class="db3-btn db3-btn-ghost" style="width:100%;justify-content:center;">
                            <i data-lucide="mail"></i> Send Verification Email
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="{{ asset('js/dashboard-3d.js') }}"></script>
<script>
    if (typeof lucide !== 'undefined') lucide.createIcons();
</script>
{% endblock %}
