{% extends 'base.html.twig' %}
{% block title %}My Profile — VirtuArts{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/dashboard-3d.css') }}">
{% endblock %}

{% block body %}
<div class="db3-page">
    <div class="db3-bg"></div>
    <div class="db3-container">

        {# ── FLASH MESSAGES ── #}
        {% for type, messages in app.flashes %}
        <div class="db3-flash-wrap">
            {% for msg in messages %}
            <div class="db3-flash {{ type }}">
                <i data-lucide="{{ type == 'success' ? 'check-circle' : (type == 'error' ? 'x-circle' : 'alert-triangle') }}"></i>
                {{ msg }}
            </div>
            {% endfor %}
        </div>
        {% endfor %}

        {# ── HEADER ── #}
        <div class="db3-header">
            <div class="db3-header-left">
                <h1>My Profile</h1>
                <p>Manage your account settings, art name, and security</p>
            </div>
            <a href="{{ path('app_user_dashboard') }}" class="db3-btn db3-btn-ghost">
                <i data-lucide="arrow-left"></i> Dashboard
            </a>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">

            {# ── AVATAR & IDENTITY ── #}
            <div class="db3-form-card">
                <div class="db3-section-title" style="margin-bottom:24px;">
                    <div class="db3-section-icon"><i data-lucide="user"></i></div>
                    <h2>Identity & Avatar</h2>
                </div>

                <form method="post" action="{{ path('app_user_profile_update') }}" enctype="multipart/form-data">
                    {# Avatar preview #}
                    <div style="display:flex;align-items:center;gap:20px;margin-bottom:24px;">
                        <div style="width:80px;height:80px;border-radius:50%;overflow:hidden;border:2px solid rgba(249,115,22,0.3);display:flex;align-items:center;justify-content:center;background:rgba(249,115,22,0.08);font-size:2rem;font-weight:800;color:#f97316;flex-shrink:0;">
                            {% if app.user.avatarPath %}
                                <img src="{{ app.user.avatarPath }}" alt="Avatar" style="width:100%;height:100%;object-fit:cover;">
                            {% else %}
                                {{ app.user.firstName|slice(0,1)|upper }}
                            {% endif %}
                        </div>
                        <div class="db3-form-group" style="flex:1;">
                            <label><i data-lucide="camera"></i> Change Avatar</label>
                            <input type="file" name="avatar" accept="image/*">
                        </div>
                    </div>

                    <div class="db3-form-row">
                        <div class="db3-form-group">
                            <label><i data-lucide="user"></i> First Name</label>
                            <input type="text" name="first_name" value="{{ app.user.firstName }}" required minlength="2" maxlength="30">
                        </div>
                        <div class="db3-form-group">
                            <label><i data-lucide="user"></i> Last Name</label>
                            <input type="text" name="last_name" value="{{ app.user.lastName }}" required minlength="2" maxlength="30">
                        </div>
                    </div>

                    <div class="db3-form-group" style="margin-bottom:20px;">
                        <label><i data-lucide="palette"></i> Art Name / Display Name</label>
                        <input type="text" name="display_name" value="{{ app.user.displayName }}" placeholder="Leave empty to use your real name" maxlength="100">
                        <span style="font-size:0.72rem;color:#57534e;">This name will be shown publicly instead of your real name</span>
                    </div>

                    <button type="submit" class="db3-btn db3-btn-primary" style="width:100%;justify-content:center;">
                        <i data-lucide="save"></i> Save Changes
                    </button>
                </form>
            </div>

            {# ── ACCOUNT INFO & SECURITY ── #}
            <div>
                {# Account Info Card #}
                <div class="db3-form-card" style="margin-bottom:24px;">
                    <div class="db3-section-title" style="margin-bottom:24px;">
                        <div class="db3-section-icon"><i data-lucide="info"></i></div>
                        <h2>Account Info</h2>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:12px;">
                        <div style="display:flex;justify-content:space-between;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;">
                            <span style="font-size:0.78rem;color:#78716c;font-weight:700;">Email</span>
                            <span style="font-size:0.84rem;color:#d6d3d1;font-family:monospace;">{{ app.user.email }}</span>
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;">
                            <span style="font-size:0.78rem;color:#78716c;font-weight:700;">Role</span>
                            <span class="db3-role {{ app.user.role|lower|default('user') }}">{{ app.user.role|default('USER') }}</span>
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;">
                            <span style="font-size:0.78rem;color:#78716c;font-weight:700;">Level</span>
                            <span style="color:#f97316;font-weight:800;">Lv.{{ app.user.level }} <span style="color:#78716c;font-weight:400;">({{ app.user.xp }} XP)</span></span>
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;">
                            <span style="font-size:0.78rem;color:#78716c;font-weight:700;">Points</span>
                            <span style="color:#f59e0b;font-weight:800;">{{ app.user.points }} ⭐</span>
                        </div>
                    </div>
                </div>

                {# Face ID Login Card #}
                {% set faceOn = app.user.faceLoginEnabled %}
                <div class="db3-form-card face-card" id="faceCard" style="margin-bottom:24px;" data-enabled="{{ faceOn ? '1' : '0' }}">
                    <div class="db3-section-title" style="margin-bottom:16px;">
                        <div class="db3-section-icon"><i data-lucide="scan-face"></i></div>
                        <h2>Face ID Login</h2>
                        <label class="face-switch" title="Sign in with your face">
                            <input type="checkbox" id="faceToggle" {{ faceOn ? 'checked' : '' }} aria-label="Face ID login">
                            <span class="face-switch-track"><span class="face-switch-thumb"></span></span>
                        </label>
                    </div>
                    {% if faceOn %}
                        <p class="face-card-text">On since {{ app.user.faceEnrolledAt ? app.user.faceEnrolledAt|date('d M Y') : '—' }}. Choose <strong>Face ID</strong> on the sign-in page to log in with your camera.</p>
                        <form method="post" action="{{ path('app_user_face_disable') }}" id="faceDisableForm">
                            <input type="hidden" name="_token" value="{{ csrf_token('face_disable') }}">
                        </form>
                    {% else %}
                        <p class="face-card-text">Sign in by looking at your camera instead of typing your password.</p>
                        <div class="face-enroll" id="faceEnroll" hidden>
                            <p class="face-card-note">Your face is turned into a numeric template that is stored on VirtuArts' servers to recognise you. No photo is saved. Turning Face ID off deletes it. Face matching is convenient but less secure than a strong password — anyone who looks very like you may be able to sign in.</p>
                            <div class="face-enroll-video"><video id="faceVideo" playsinline muted></video></div>
                            <p class="face-card-status" id="faceStatus" aria-live="polite">Confirm your password, then start the scan.</p>
                            <div class="db3-form-group"><input type="password" id="facePassword" placeholder="Current password" autocomplete="current-password" aria-label="Current password"></div>
                            <div style="display:flex;gap:8px;">
                                <button type="button" class="db3-btn db3-btn-primary" id="faceStart" style="flex:1;justify-content:center;"><i data-lucide="scan-face"></i> Start face scan</button>
                                <button type="button" class="db3-btn db3-btn-ghost" id="faceCancel">Cancel</button>
                            </div>
                        </div>
                    {% endif %}
                </div>

                {# Password Change Card #}
                <div class="db3-form-card">
                    <div class="db3-section-title" style="margin-bottom:24px;">
                        <div class="db3-section-icon"><i data-lucide="lock"></i></div>
                        <h2>Change Password</h2>
                    </div>
                    <p style="font-size:0.84rem;color:#a8a29e;line-height:1.6;margin:0 0 16px;">
                        For security, password changes require email verification. Click the button below and we'll send a verification link to <strong style="color:#d6d3d1;">{{ app.user.email }}</strong>.
                    </p>
                    <form method="post" action="{{ path('app_user_request_password_change') }}">
                        <button type="submit" class="db3-btn db3-btn-ghost" style="width:100%;justify-content:center;">
                            <i data-lucide="mail"></i> Send Verification Email
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="{{ asset('js/dashboard-3d.js') }}"></script>
<script>
    if (typeof lucide !== 'undefined') lucide.createIcons();
</script>
<style>
    .face-card .db3-section-title { align-items: center; }
    .face-switch { margin-left: auto; display: inline-flex; cursor: pointer; }
    .face-switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
    .face-switch-track { width: 46px; height: 26px; border-radius: 999px; background: #44403c; position: relative; transition: background .2s; }
    .face-switch-thumb { position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: transform .2s; }
    .face-switch input:checked + .face-switch-track { background: #f97316; }
    .face-switch input:checked + .face-switch-track .face-switch-thumb { transform: translateX(20px); }
    .face-switch input:focus-visible + .face-switch-track { outline: 2px solid #fdba74; outline-offset: 2px; }
    .face-card-text { font-size: .84rem; color: #a8a29e; line-height: 1.6; margin: 0; }
    .face-enroll { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
    .face-enroll[hidden] { display: none; }
    .face-card-note { font-size: .74rem; color: #78716c; line-height: 1.5; margin: 0; padding: 10px 12px; border-radius: 10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); }
    .face-enroll-video { width: 180px; height: 180px; margin: 4px auto; border-radius: 50%; overflow: hidden; background: #0c0a09; border: 2px solid rgba(249,115,22,0.4); }
    .face-enroll-video video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
    .face-card-status { text-align: center; font-size: .84rem; color: #d6d3d1; margin: 0; min-height: 1.4em; }
    .face-card-status.error { color: #fca5a5; }
</style>
<script src="{{ asset('js/face-auth.js') }}"></script>
<script>
(function () {
    const card = document.getElementById('faceCard');
    const toggle = document.getElementById('faceToggle');
    if (!card || !toggle) return;

    if (card.dataset.enabled === '1') {
        toggle.addEventListener('change', () => {
            if (toggle.checked) return;
            if (confirm('Turn off Face ID login? Your stored face template will be deleted.')) document.getElementById('faceDisableForm').submit();
            else toggle.checked = true;
        });
        return;
    }

    const panel = document.getElementById('faceEnroll');
    const video = document.getElementById('faceVideo');
    const status = document.getElementById('faceStatus');
    const pwd = document.getElementById('facePassword');
    const startBtn = document.getElementById('faceStart');
    const say = (msg, err) => { status.textContent = msg; status.classList.toggle('error', !!err); };
    const close = () => { panel.hidden = true; toggle.checked = false; window.VAFaceAuth.stop(); video.srcObject = null; };

    toggle.addEventListener('change', () => { if (toggle.checked) { panel.hidden = false; pwd.focus(); } else close(); });
    document.getElementById('faceCancel').addEventListener('click', close);

    let busy = false;
    startBtn.addEventListener('click', async () => {
        if (busy) return;
        if (!pwd.value) { say('Enter your current password first.', true); pwd.focus(); return; }
        busy = true; startBtn.disabled = true;
        try {
            const samples = await window.VAFaceAuth.capture({ video, samples: 3, onStatus: (s, m) => say(m) });
            say('Saving…');
            const res = await fetch('{{ path('app_user_face_enable') }}', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ samples, password: pwd.value, _token: '{{ csrf_token('face_enroll') }}' }),
            });
            const data = await res.json().catch(() => ({}));
            if (data.ok) { say('✅ Face ID login is on.'); window.VAFaceAuth.stop(); setTimeout(() => location.reload(), 700); return; }
            say(data.error || 'Could not turn on Face ID.', true);
        } catch (e) {
            say(e.name === 'NotAllowedError' ? 'Camera permission was denied.' : (e.message || 'Face scan failed.'), true);
        } finally { busy = false; startBtn.disabled = false; }
    });
})();
</script>
{% endblock %}
