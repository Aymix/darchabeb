{% extends 'base.html.twig' %}
{% block title %}Change Password — VirtuArts{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/dashboard-3d.css') }}">
{% endblock %}

{% block body %}
<div class="db3-page">
    <div class="db3-bg"></div>
    <div class="db3-container" style="max-width:500px;">

        {% for type, messages in app.flashes %}
        <div class="db3-flash-wrap">
            {% for msg in messages %}
            <div class="db3-flash {{ type }}">
                <i data-lucide="{{ type == 'success' ? 'check-circle' : 'x-circle' }}"></i>
                {{ msg }}
            </div>
            {% endfor %}
        </div>
        {% endfor %}

        <div class="db3-form-card">
            <div class="db3-section-title" style="margin-bottom:24px;">
                <div class="db3-section-icon"><i data-lucide="lock"></i></div>
                <h2>Set New Password</h2>
            </div>

            <p style="font-size:0.84rem;color:#a8a29e;line-height:1.6;margin:0 0 20px;">
                ✅ Email verified! You can now set a new password for your account.
            </p>

            <form method="post" action="{{ path('app_user_change_password', {token: token}) }}">
                <div class="db3-form-group" style="margin-bottom:16px;">
                    <label><i data-lucide="key"></i> New Password</label>
                    <input type="password" name="new_password" required minlength="6" placeholder="At least 6 characters">
                </div>
                <div class="db3-form-group" style="margin-bottom:20px;">
                    <label><i data-lucide="key"></i> Confirm New Password</label>
                    <input type="password" name="confirm_password" required minlength="6" placeholder="Repeat your new password">
                </div>
                <button type="submit" class="db3-btn db3-btn-primary" style="width:100%;justify-content:center;">
                    <i data-lucide="save"></i> Change Password
                </button>
            </form>

            <div style="margin-top:16px;text-align:center;">
                <a href="{{ path('app_user_profile') }}" style="color:#78716c;font-size:0.8rem;text-decoration:none;">← Back to Profile</a>
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
    if (typeof lucide !== 'undefined') lucide.createIcons();
</script>
{% endblock %}
